<odoo>
    <record id="ydental_operating_report_action" model="ir.actions.act_url">
        <field name="name">Operating reports and source documents</field>
        <field name="url">/ydental/reports</field><field name="target">self</field>
    </record>
    <menuitem id="ydental_operating_report_menu" name="Operating reports and source documents" action="ydental_operating_report_action" groups="ydental_base.ydental_base_group_user"/>
    <template id="ydental_operating_report_navigation" name="Operating report navigation">
        <nav aria-label="Business navigation" t-att-class="'o_ydental_reporting_navigation o_ydental_reporting_main_spacing_navigation' if report_main_actions else 'o_ydental_reporting_navigation'">
            <a href="/ydental/access" t-att-class="'o_ydental_reporting_main_action o_ydental_reporting_main_action_quiet' if report_main_actions else None" t-att-data-dl-actions="'report-actions' if report_main_actions else None">Current store and permissions</a>
            <a href="/ydental/documents" t-att-class="'o_ydental_reporting_main_action o_ydental_reporting_main_action_quiet' if report_main_actions else None" t-att-data-dl-actions="'report-actions' if report_main_actions else None">Document originals</a>
            <a href="/ydental/settlement" t-att-class="'o_ydental_reporting_main_action o_ydental_reporting_main_action_quiet' if report_main_actions else None" t-att-data-dl-actions="'report-actions' if report_main_actions else None">Settlement workbench</a>
        </nav>
    </template>
    <template id="ydental_operating_report_scope" name="Effective report scope">
        <div t-att-class="'o_ydental_reporting_scope o_ydental_reporting_main_spacing_scope' if report_main_actions else 'o_ydental_reporting_scope'">
            <p><strong>Authorized report scope:</strong> <t t-out="display['scope']"/> · <t t-out="display['companies']"/></p>
            <p><strong>Local source dates:</strong> <t t-out="report['filters']['date_from']"/> — <t t-out="report['filters']['date_to']"/> · <t t-out="display['currency']"/> · <t t-out="display['state_label']"/></p>
            <p><strong>Queried at (UTC):</strong> <t t-out="report['filters']['query_at_utc']"/></p>
            <details><summary t-att-class="'o_ydental_reporting_main_disclosure' if report_main_actions else None" t-att-data-dl-actions="'report-actions' if report_main_actions else None">Store timezones and effective UTC boundaries</summary>
                <ul><li t-foreach="display['bounds']" t-as="bound"><t t-out="bound['label']"/> · <t t-out="bound['timezone']"/>:
                    <t t-out="bound['start_utc']"/> ≤ UTC &lt; <t t-out="bound['end_exclusive_utc']"/>
                </li></ul>
                <p>Dates select source records. Snapshot metrics show their current state at query time, without historical balance reconstruction.</p>
            </details>
        </div>
    </template>
    <template id="ydental_operating_report_source" name="Reauthorized operating report source detail">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
            <main class="container o_ydental_reporting o_ydental_reporting_source">
                <t t-call="ydental_reporting.ydental_operating_report_navigation"/>
                <p><a t-att-href="return_url">Return to the same report filters and page</a></p>
                <h1 t-out="title"/>
                <p class="o_ydental_reporting_notice">This is an authorized view of current source facts. Viewing does not collect, refund, receive or move stock.</p>
                <t t-call="ydental_reporting.ydental_operating_report_scope"/>
                <article t-foreach="display['rows']" t-as="row" class="o_ydental_reporting_source_card">
                    <h2 t-out="row['source_label']"/>
                    <p t-out="row['patient_label']"/>
                    <p><strong t-out="row['quantity']['value']"/> · <t t-out="row['quantity']['label']"/> · <t t-out="row['state_label']"/></p>
                    <p><strong>Business date / source time:</strong> <t t-out="row['event_label']"/></p>
                    <dl class="o_ydental_reporting_facts"><t t-foreach="row['facts_display']" t-as="fact"><dt t-out="fact[0]"/><dd t-out="fact[1]"/></t></dl>
                    <div t-if="row['allocations']" class="o_ydental_reporting_table_wrap" tabindex="0" role="region" aria-label="Selected bills and current native allocations">
                        <table class="table"><thead><tr><th>Selected bill</th><th>Original amount</th><th>Native collection allocation</th><th>Current receivable</th></tr></thead>
                            <tbody><tr t-foreach="row['allocations']" t-as="allocation"><td><a t-att-href="allocation['url']" t-out="allocation['number']"/></td><td t-out="allocation['total']"/><td t-out="allocation['allocated']"/><td t-out="allocation['balance']"/></tr></tbody>
                        </table>
                    </div>
                    <p t-if="row['requires_store_switch']" class="o_ydental_reporting_notice">Select this source store through the normal store selector before opening its business page. Report access does not grant cross-store handling permission.</p>
                    <p><a t-att-href="row['business_url']">Open the source business page</a> · <a t-att-href="row['native_url']">Native source document (permissions checked again)</a></p>
                    <details><summary>Technical trace and complete source facts</summary>
                        <p><t t-out="row['source_model']"/> / <t t-out="row['source_id']"/></p>
                        <pre t-out="row['trace']"/>
                    </details>
                </article>
                <p><a t-att-href="return_url">Return to the same report filters and page</a></p>
            </main>
        </t>
    </template>
    <template id="ydental_operating_report_page" name="Source-backed operating reports">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
            <main class="container o_ydental_reporting" data-dl-layout="report-actions-spacing">
                <t t-call="ydental_reporting.ydental_operating_report_navigation"><t t-set="report_main_actions" t-value="True"/></t>
                <h1 class="o_ydental_reporting_main_spacing_title">Operating reports and source documents</h1>
                <p class="o_ydental_reporting_notice o_ydental_reporting_main_spacing_intro">Synthetic software definitions await business review. Collections are not revenue; credit notes are not cash refunds. Currencies and units are reported separately.</p>
                <form action="/ydental/reports" method="get" class="o_ydental_reporting_filters o_ydental_reporting_filter_scope" data-dl-scope="report-filters">
                    <input type="hidden" name="revision" t-att-value="revision"/>
                    <div class="o_ydental_reporting_filter_dates">
                        <div class="o_ydental_reporting_filter_field">
                            <label id="ydental-report-metric-label" for="ydental-report-metric">Metric</label>
                            <select id="ydental-report-metric" name="metric" data-report-filter-select="true" aria-describedby="ydental-report-metric-help"><option t-foreach="choices" t-as="choice" t-att-value="choice['key']" t-att-selected="choice['key'] == values['metric']" t-out="choice['label']"/></select>
                        </div>
                        <div class="o_ydental_reporting_filter_field">
                            <label for="ydental-report-date-from">Local start date</label>
                            <input id="ydental-report-date-from" name="date_from" type="date" t-att-value="values['date_from']" required="required"/>
                        </div>
                        <div class="o_ydental_reporting_filter_field">
                            <label for="ydental-report-date-to">Local end date</label>
                            <input id="ydental-report-date-to" name="date_to" type="date" t-att-value="values['date_to']" required="required"/>
                        </div>
                    </div>
                    <div class="o_ydental_reporting_filter_range">
                        <fieldset class="o_ydental_reporting_filter_stores" aria-describedby="ydental-report-stores-help ydental-report-stores-error">
                            <legend id="ydental-report-stores-label">Authorized stores (multiple selection)</legend>
                            <select id="ydental-report-stores" name="store_ids" multiple="multiple" size="3" required="required" aria-labelledby="ydental-report-stores-label" aria-describedby="ydental-report-stores-help ydental-report-stores-error"><option t-foreach="options['stores']" t-as="store" t-att-value="store['id']" t-att-selected="store['id'] in selected_stores"><t t-out="store['label']"/> · <t t-out="store['timezone']"/></option></select>
                            <p id="ydental-report-stores-help" class="o_ydental_reporting_filter_help">Select at least one authorized store. This does not change your current working store.</p>
                            <p id="ydental-report-stores-error" class="o_ydental_reporting_filter_error" data-report-filter-error="stores" role="alert" hidden="hidden">Select at least one authorized store.</p>
                            <p data-report-filter-message="unavailable" hidden="hidden">No stores are available in this authorized metric scope.</p>
                        </fieldset>
                        <div class="o_ydental_reporting_filter_conditions">
                            <div class="o_ydental_reporting_filter_field">
                                <label id="ydental-report-company-label" for="ydental-report-company">Legal entity</label>
                                <select id="ydental-report-company" name="company_id" data-report-filter-select="true"><option value="">All explicitly selected authorized entities</option><option t-foreach="options['companies']" t-as="company" t-att-value="company['id']" t-att-selected="str(company['id']) == str(values.get('company_id',''))" t-out="company['label']"/></select>
                            </div>
                            <div t-if="options['money']" class="o_ydental_reporting_filter_field">
                                <label id="ydental-report-currency-label" for="ydental-report-currency">Currency</label>
                                <select id="ydental-report-currency" name="currency_id" data-report-filter-select="true"><option value="">Separate totals per currency</option><option t-foreach="options['currencies']" t-as="currency" t-att-value="currency['id']" t-att-selected="str(currency['id']) == str(values.get('currency_id',''))" t-out="currency['label']"/></select>
                            </div>
                            <div t-if="options['states']" class="o_ydental_reporting_filter_field">
                                <label id="ydental-report-state-label" for="ydental-report-state">Source state</label>
                                <select id="ydental-report-state" name="state" data-report-filter-select="true"><option value="">All applicable source states</option><option t-foreach="options['states']" t-as="state" t-att-value="state['value']" t-att-selected="state['value'] == values.get('state')" t-out="state['label']"/></select>
                            </div>
                        </div>
                    </div>
                    <div class="o_ydental_reporting_filter_actions">
                        <button type="submit" class="o_ydental_reporting_filter_button o_ydental_reporting_main_action o_ydental_reporting_main_action_primary" data-dl-actions="report-actions"><t t-call="ydental_inventory.p7_icon_search"/><span class="o_ydental_reporting_main_action_label" t-translation="on">Query authorized sources</span></button>
                        <p id="ydental-report-metric-help" class="o_ydental_reporting_filter_help">Changing the metric queries again, keeps the dates, restores the current store and clears entity, currency and state filters.</p>
                        <p class="o_ydental_reporting_filter_help">After changing other filters, select Query. Results, exports and source links use the last applied filters.</p>
                        <p class="o_ydental_reporting_filter_status" data-report-filter-busy="true" role="status" hidden="hidden">Querying authorized sources...</p>
                    </div>
                    <p data-report-filter-message="required" hidden="hidden">Select an available option.</p>
                </form>
                <h2 t-out="display['title']" class="o_ydental_reporting_main_spacing_result_title"/>
                <p t-if="report['filters']['metric'] == 'receivables'" class="o_ydental_reporting_notice o_ydental_reporting_main_spacing_result_notice">Current receivable for the selected original bill date range. Dates do not represent a historical balance cutoff.</p>
                <p t-elif="report['filters']['period_or_snapshot'] == 'snapshot'" class="o_ydental_reporting_notice o_ydental_reporting_main_spacing_result_notice">Current responsibility or pending amount at query time; dates select the source records.</p>
                <p t-else="" class="o_ydental_reporting_notice o_ydental_reporting_main_spacing_result_notice">Actual events within the selected local business dates.</p>
                <t t-call="ydental_reporting.ydental_operating_report_scope"><t t-set="report_main_actions" t-value="True"/></t>
                <div class="o_ydental_reporting_totals o_ydental_reporting_main_spacing_totals" aria-label="Totals by currency or unit">
                    <article t-foreach="display['totals']" t-as="total"><strong t-out="total['value']"/><span t-out="total['label']"/><small t-if="total['events'] is not None"><t t-out="total['events']"/> source events</small></article>
                </div>
                <p t-if="not display['rows']" class="o_ydental_reporting_notice o_ydental_reporting_main_spacing_note">No applicable sources match these authorized filters. Adjust the dates, stores or applicable state.</p>
                <p t-if="report['filters']['metric'] == 'unique_patients'" class="o_ydental_reporting_main_spacing_note">The combined patient total is deduplicated across the selected stores; store patient counts must not be added together.</p>
                <details t-if="display['store_totals']" class="o_ydental_reporting_main_spacing_store_totals"><summary class="o_ydental_reporting_main_disclosure" data-dl-actions="report-actions">Totals by authorized store</summary><ul><li t-foreach="display['store_totals']" t-as="store"><strong t-out="store['label']"/><ul><li t-foreach="store['totals']" t-as="total"><t t-out="total['label']"/>: <t t-out="total['value']"/></li></ul></li></ul></details>
                <form action="/ydental/reports/export" method="post" class="o_ydental_reporting_export">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="revision" t-att-value="revision"/>
                    <input t-foreach="['metric','date_from','date_to','store_ids','company_id','currency_id','state']" t-as="field_name" type="hidden" t-att-name="field_name" t-att-value="values.get(field_name,'')"/>
                    <button type="submit" class="btn btn-outline-secondary o_ydental_reporting_main_action o_ydental_reporting_main_action_secondary" data-dl-actions="report-actions"><span class="o_ydental_reporting_main_action_label" t-translation="on">Export all matching sources (store export permission required)</span></button>
                </form>
                <div class="o_ydental_reporting_table_wrap o_ydental_reporting_main_spacing_table" tabindex="0" role="region" aria-label="Authorized source details">
                    <table class="table"><thead><tr><th>Store / legal entity</th><th>Business document / patient</th><th>Business date / source time</th><th>Business state</th><th>Amount / quantity</th><th>Source details</th></tr></thead><tbody>
                        <tr t-foreach="display['rows']" t-as="row">
                            <td><t t-out="row['store_label']"/><small t-out="row['company_label']"/></td>
                            <td><strong t-out="row['source_label']"/><small t-out="row['patient_label']"/></td>
                            <td t-out="row['event_label']"/><td t-out="row['state_label']"/>
                            <td><strong t-out="row['quantity']['value']"/><small t-out="row['quantity']['label']"/></td>
                            <td><a t-att-href="row['source_url']" class="o_ydental_reporting_main_action o_ydental_reporting_main_action_quiet" data-dl-actions="report-actions"><span class="o_ydental_reporting_main_action_label" t-translation="on">View source and allocations</span><t t-call="ydental_inventory.p7_icon_arrow_right"/></a></td>
                        </tr>
                    </tbody></table>
                </div>
                <nav class="o_ydental_reporting_navigation o_ydental_reporting_main_spacing_navigation o_ydental_reporting_main_spacing_pagination" aria-label="Source pages"><a t-if="report['page'] &gt; 1" t-att-href="previous_url" class="o_ydental_reporting_main_action o_ydental_reporting_main_action_secondary" data-dl-actions="report-actions"><t t-call="ydental_inventory.p7_icon_chevron_left"/><span class="o_ydental_reporting_main_action_label" t-translation="on">Previous page</span></a><span>Page <t t-out="report['page']"/> · <t t-out="report['source_row_count']"/> matching source records</span><a t-if="report['page'] * report['page_size'] &lt; report['source_row_count']" t-att-href="next_url" class="o_ydental_reporting_main_action o_ydental_reporting_main_action_secondary" data-dl-actions="report-actions"><span class="o_ydental_reporting_main_action_label" t-translation="on">Next page</span><t t-call="ydental_inventory.p7_icon_chevron_right"/></a></nav>
            </main>
        </t>
    </template>
    <template id="ydental_operating_report_error" name="Operating report access and filter feedback">
        <t t-call="web.frontend_layout"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
            <main class="container o_ydental_reporting"><h1>Report request could not be completed</h1>
                <p>Check the selected store, source permission and explicit filters. Unavailable stores are rejected instead of silently reducing the scope.</p>
                <p t-out="message" class="o_ydental_reporting_notice"/>
                <p><a href="/ydental/reports">Open reports with the current store defaults</a> · <a href="/ydental/access">Choose the current store</a></p>
            </main>
        </t>
    </template>
</odoo>
