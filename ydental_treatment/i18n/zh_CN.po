#. module: ydental_treatment
#. odoo-python
#: code:addons/ydental_treatment/models/ydental_treatment_service.py:0
msgid ""
"invalid_order: Verify the actual active medicine, native unit and pharmacy "
"direction before issue."
msgstr "invalid_order: 开立前须核实真实启用药品、原生单位和药房服务方向。"

#. module: ydental_treatment
#. odoo-python
#: code:addons/ydental_treatment/models/ydental_treatment_service.py:0
msgid ""
"medicine_evidence_missing: Historical medication needs a separately "
"evidenced review before new corrections."
msgstr "medicine_evidence_missing: 历史用药须先有独立核对证据，才能新增更正。"

#. module: ydental_treatment
#. odoo-python
#: code:addons/ydental_treatment/models/ydental_treatment_service.py:0
msgid ""
"medicine_evidence_missing: Only the original operator may append batch "
"evidence to this unresolved actual medication fact."
msgstr "medicine_evidence_missing: 仅原责任人可为本条待核对实际用药追加批次证据。"

#. module: ydental_treatment
#. odoo-python
#: code:addons/ydental_treatment/models/ydental_treatment_service.py:0
msgid ""
"medicine_evidence_missing: Verify exact medicine SKU, native unit, batches "
"and total actual quantity before confirming fee and stock."
msgstr "medicine_evidence_missing: 确认费用库存前须核实药品品种、原生单位、批次与实际总用量一致。"

#. module: ydental_treatment
#. odoo-python
#: code:addons/ydental_treatment/models/ydental_treatment_service.py:0
msgid ""
"medicine_price_unverified: A published SKU association is immutable; shared "
"generic medicine pricing has no approved policy."
msgstr "medicine_price_unverified: 已发布品种关联不可改写；多药共用泛化价格尚无已批准政策。"

#. module: ydental_treatment
#. odoo-python
#: code:addons/ydental_treatment/models/ydental_treatment_service.py:0
msgid ""
"medicine_price_unverified: Associate one real medicine SKU with its exact "
"native unit and medicine fee catalog."
msgstr "medicine_price_unverified: 须将一个真实药品品种及其原生单位明确关联到药品收费目录。"

#. module: ydental_treatment
#. odoo-python
#: code:addons/ydental_treatment/models/ydental_inventory_service.py:0
msgid ""
"medicine_price_unverified: Inventory and fees must use the exact published "
"SKU price source."
msgstr "medicine_price_unverified: 库存与费用必须使用同一已发布药品品种价源。"

#. module: ydental_treatment
#. odoo-python
#: code:addons/ydental_treatment/models/ydental_treatment_service.py:0
msgid ""
"medicine_price_unverified: Publish an evidenced store SKU and fee catalog "
"association before new medication execution."
msgstr "medicine_price_unverified: 新用药执行前须发布本店有据的药品品种与收费目录关联。"

#. module: ydental_treatment
#. odoo-python
#: code:addons/ydental_treatment/models/ydental_treatment_service.py:0
msgid ""
"medicine_price_unverified: The actual SKU has no matching published fee "
"source."
msgstr "medicine_price_unverified: 实际药品品种没有匹配的已发布收费来源。"

#. module: ydental_treatment
#. odoo-python
#: code:addons/ydental_treatment/models/ydental_treatment_service.py:0
msgid ""
"medicine_price_unverified: The fee catalog needs an approved mapping in this"
" store."
msgstr "medicine_price_unverified: 收费目录须有本店已批准服务映射。"

#. module: ydental_treatment
#. odoo-python
#: code:addons/ydental_treatment/models/ydental_treatment_service.py:0
msgid ""
"medicine_price_unverified: The verified SKU must retain the original fee "
"catalog and historical price."
msgstr "medicine_price_unverified: 核实药品品种须保留原收费目录与历史价格。"
