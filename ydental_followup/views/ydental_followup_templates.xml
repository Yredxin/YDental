<odoo>
    <template id="followup_list" name="Follow-up workbench">
        <t t-call="web.frontend_layout">
            <main class="container py-4 o_ydental_access_followup">
                <h1>Follow-up workbench</h1>
                <p>Store: <strong t-out="store.name"/>. Appointment, actual arrival, treatment and contact status remain separate.</p>
                <section class="card my-3">
                    <div class="card-body">
                        <details t-if="can_write" t-att-open="'open' if source_q or source_cursor else None"><summary>从实际治疗创建复诊计划</summary>
                            <p t-if="not medical_read">创建复诊计划需要本店医疗来源读取权限，请联系授权人员。</p>
                            <form t-if="medical_read" method="get" action="/ydental/followups"><label>患者姓名或编号 <input name="source_q" maxlength="100" t-att-value="source_q"/></label><button type="submit">搜索治疗来源</button></form>
                            <p t-if="medical_read and not source_events and source_next">本批没有可用来源；仍有记录，请继续查找或用患者编号缩小范围。</p>
                            <p t-if="medical_read and not source_events and not source_next">没有更多可用治疗来源；请检查患者或重新搜索。</p>
                            <form t-if="medical_read and source_events" action="/ydental/followups/action" method="post" class="row g-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="revision" t-att-value="revision"/>
                            <input type="hidden" name="operation" value="create"/>
                            <input type="hidden" name="ui_source" value="patient_event"/>
                            <label class="col-md-6">选择患者及已确认治疗
                                <select class="form-select" name="source_choice" required="required">
                                    <option value="">请选择实际治疗来源</option>
                                    <t t-foreach="source_events" t-as="event">
                                        <t t-set="event_patient" t-value="event.ydental_execution_id.ydental_patient_id"/>
                                        <option t-att-value="'%s:%s' % (event_patient.id, event.id)"><t t-out="event_patient.name"/> · <t t-out="event_patient.ydental_number"/> · <t t-out="event.ydental_actual_at"/> UTC · <t t-out="event.ydental_catalog_id.name"/> · <t t-out="event.ydental_actor_id.name"/></option>
                                    </t>
                                </select>
                            </label>
                            <label class="col-md-2">Type
                                <select class="form-select" name="followup_type"><option value="post_visit">Post-visit</option><option value="other">Other</option></select>
                            </label>
                            <label class="col-md-2">Planned at <input class="form-control" name="planned_at" type="datetime-local" required="required"/></label>
                            <label class="col-md-2">Deadline <input class="form-control" name="deadline_at" type="datetime-local"/></label>
                            <input type="hidden" name="responsible_id" t-att-value="current_user.id"/>
                            <div class="col-12"><button class="btn btn-primary" type="submit">Create plan</button></div>
                        </form><nav t-if="medical_read" aria-label="治疗来源分页"><a t-if="source_next" t-att-href="source_page_url(source_next)">继续查找</a> <a href="/ydental/followups">重新搜索</a><span>可使用浏览器后退查看上一批。</span></nav>
                    </details></div>
                </section>
                <section class="table-responsive">
                    <div class="o_ydental_access_scroll" tabindex="0" aria-label="Scrollable details"><table class="table table-striped">
                        <thead><tr><th>Patient</th><th>Type</th><th>Planned</th><th>Appointment</th><th>Appointment status</th><th>Follow-up state</th><th>Responsible</th><th>Actions</th></tr></thead>
                        <tbody>
                            <t t-foreach="rows" t-as="row">
                                <tr t-att-id="'followup-%s' % row.id">
                                    <td t-out="row.ydental_patient_id.name"/>
                                    <td>
                                        <t t-out="type_labels[row.ydental_followup_type]"/>
                                        <p t-if="row.ydental_lab_contact_stage == 'waiting'" class="text-muted mb-0">Waiting for laboratory stock. Only a real linked reservation may be reminded.</p>
                                        <p t-if="row.ydental_lab_contact_stage == 'ready'" class="text-muted mb-0">Laboratory stock is available.</p>
                                        <p t-if="row.ydental_lab_contact_stage == 'stopped'" class="text-muted mb-0">Laboratory contact stopped. Existing history and internal review remain.</p>
                                    </td>
                                    <td t-out="row.ydental_planned_at"/>
                                    <td t-out="row.ydental_appointment_at or ''"/>
                                    <td t-out="appointment_labels[row.ydental_appointment_status]"/>
                                    <td t-out="state_labels[row.state]"/>
                                    <td t-out="row.ydental_responsible_id.name"/>
                                    <td>
                                        <p t-if="row.state in ('closed', 'done')"><strong>Read-only terminal history</strong><br/><span t-out="row.ydental_closed_reason or ''"/></p><details t-if="can_write and (row.state not in ('closed', 'done') and (lab_contact_allowed[row.id]))"><summary>Record contact</summary>
                                            <form action="/ydental/followups/action" method="post">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="revision" t-att-value="revision"/>
                                                <input type="hidden" name="operation" value="contact"/>
                                                <input type="hidden" name="followup_id" t-att-value="row.id"/>
                                                <select class="form-select" name="method"><option value="phone">Telephone</option><option value="message">Message</option><option value="other">Other</option></select>
                                                <select class="form-select" name="outcome"><option value="no_answer">No answer</option><option value="failed">Failed</option><option value="accepted">Accepted</option><option value="delivered">Confirmed delivered</option><option value="unknown">Unknown</option></select>
                                                <input class="form-control" name="note" maxlength="300" placeholder="Brief operational note"/>
                                                <button class="btn btn-secondary" type="submit">Save contact result</button>
                                            </form>
                                        </details>
                                        <details t-if="can_write and (row.state not in ('closed', 'done'))"><summary>Reschedule contact</summary>
                                            <form action="/ydental/followups/action" method="post">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="revision" t-att-value="revision"/>
                                                <input type="hidden" name="operation" value="reschedule"/>
                                                <input type="hidden" name="followup_id" t-att-value="row.id"/>
                                                <input class="form-control" name="planned_at" type="datetime-local" required="required"/>
                                                <input class="form-control" name="deadline_at" type="datetime-local"/>
                                                <button class="btn btn-secondary" type="submit">Reschedule</button>
                                            </form>
                                        </details>
                                        <details t-if="can_write and (row.state not in ('closed', 'done'))"><summary>Link a reservation</summary>
                                            <form action="/ydental/followups/action" method="post">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="revision" t-att-value="revision"/>
                                                <input type="hidden" name="operation" value="link_appointment"/>
                                                <input type="hidden" name="followup_id" t-att-value="row.id"/>
                                                <label>Existing reservation for this patient
                                                    <select class="form-select" name="appointment_id" required="required">
                                                        <option value="">Choose an active reservation</option>
                                                        <t t-foreach="appointments_by_patient.get(row.ydental_patient_id.id, [])" t-as="appointment">
                                                            <option t-att-value="appointment['id']"><t t-out="appointment['slot_start']"/> — reservation <t t-out="appointment['id']"/></option>
                                                        </t>
                                                    </select>
                                                </label>
                                                <button class="btn btn-secondary" type="submit">Link reservation</button>
                                            </form>
                                        </details>
                                        <details t-if="can_write and (row.state not in ('closed', 'done'))"><summary>Clear intake-cancelled reservation</summary>
                                            <form action="/ydental/followups/action" method="post">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="revision" t-att-value="revision"/>
                                                <input type="hidden" name="operation" value="link_appointment"/>
                                                <input type="hidden" name="followup_id" t-att-value="row.id"/>
                                                <input type="hidden" name="status" value="cancelled"/>
                                                <button class="btn btn-secondary" type="submit">Clear cancelled link</button>
                                            </form>
                                        </details>
                                        <details t-if="can_write and (row.state not in ('closed', 'done'))"><summary>Record actual arrival</summary>
                                            <form action="/ydental/followups/action" method="post">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="revision" t-att-value="revision"/>
                                                <input type="hidden" name="operation" value="record_arrival"/>
                                                <input type="hidden" name="followup_id" t-att-value="row.id"/>
                                                <label>Actual arrival for this patient
                                                    <select class="form-select" name="arrival_id" required="required">
                                                        <option value="">Choose an actual arrival</option>
                                                        <t t-foreach="arrivals_by_patient.get(row.ydental_patient_id.id, [])" t-as="arrival">
                                                            <option t-att-value="arrival.id"><t t-out="arrival.ydental_date"/> — <t t-out="arrival.ydental_occurred_at"/></option>
                                                        </t>
                                                    </select>
                                                </label>
                                                <button class="btn btn-secondary" type="submit">Link actual arrival</button>
                                            </form>
                                        </details>
                                        <a t-if="can_complete and focused_followup != row.id and row.state not in ('closed', 'done') and row.ydental_lab_contact_stage not in ('waiting', 'stopped')" t-att-href="event_page_url(row, '')">选择该患者的后续治疗来源</a>
                                        <details t-if="can_complete and focused_followup == row.id and (row.state not in ('closed', 'done') and (row.ydental_lab_contact_stage not in ('waiting', 'stopped')))" open="open"><summary>从实际治疗完成复诊</summary>
                                            <p t-if="row.ydental_appointment_id and row.ydental_appointment_status != 'arrived'">已关联预约，须先记录该预约实际到店，才能选择对应治疗来源。</p>
                                            <p t-elif="not events_by_patient.get(row.ydental_patient_id.id, [])">本页没有可选的后续治疗来源；请核对患者、预约、权限或上一页。</p>
                                            <form action="/ydental/followups/action" method="post">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="revision" t-att-value="revision"/>
                                                <input type="hidden" name="operation" value="complete"/>
                                                <input type="hidden" name="followup_id" t-att-value="row.id"/>
                                                <label>Confirmed treatment from this patient's actual visit
                                                    <select class="form-select" name="event_id" required="required">
                                                        <option value="">Choose a completed treatment event</option>
                                                        <t t-foreach="events_by_patient.get(row.ydental_patient_id.id, [])" t-as="event">
                                                            <option t-att-value="event.id"><t t-out="event.ydental_execution_id.ydental_patient_id.name"/> · <t t-out="event.ydental_execution_id.ydental_patient_id.ydental_number"/> · <t t-out="event.ydental_actual_at"/> UTC · <t t-out="event.ydental_catalog_id.name"/> · <t t-out="event.ydental_actor_id.name"/> · <t t-out="event.ydental_store_id.name"/></option>
                                                        </t>
                                                    </select>
                                                </label>
                                                <label><input type="checkbox" name="confirmed_unlinked" value="yes"/> Confirm encounter association when no reservation is linked</label>
                                                <input class="form-control" name="reason" maxlength="300" placeholder="Required when unlinked"/>
                                                <button class="btn btn-secondary" type="submit">Complete from event</button>
                                            </form>
                                            <nav aria-label="后续治疗来源分页"><a t-if="event_next" t-att-href="event_page_url(row, event_next)">继续查找</a> <a t-att-href="event_page_url(row, '')">回到第一批</a><span>可使用浏览器后退查看上一批。</span></nav>
                                        </details>
                                        <details><summary>Contact history</summary>
                                            <p class="text-muted">Latest readable attempts, up to 1,000 for this page.</p>
                                            <ul class="list-group list-group-flush">
                                                <t t-foreach="contacts_by_followup.get(row.id, [])" t-as="contact">
                                                    <li class="list-group-item">
                                                        <strong t-out="contact.ydental_contacted_at"/> —
                                                        <t t-out="contact_method_labels[contact.ydental_method]"/> / <t t-out="contact_outcome_labels[contact.ydental_outcome]"/>
                                                        — <t t-out="contact.ydental_actor_id.name"/>
                                                        <p t-if="contact.ydental_note" t-out="contact.ydental_note" class="mb-0"/>
                                                    </li>
                                                </t>
                                                <li t-if="not contacts_by_followup.get(row.id, [])" class="list-group-item text-muted">No contact attempts are available in this view.</li>
                                            </ul>
                                        </details>
                                        <details t-if="can_write and (row.state not in ('closed', 'done'))"><summary>Close with reason</summary>
                                            <form action="/ydental/followups/action" method="post">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="revision" t-att-value="revision"/>
                                                <input type="hidden" name="operation" value="close"/>
                                                <input type="hidden" name="followup_id" t-att-value="row.id"/>
                                                <input class="form-control" name="reason" maxlength="300" required="required" placeholder="Reason"/>
                                                <button class="btn btn-secondary" type="submit">Close plan</button>
                                            </form>
                                        </details>
                                        <t t-if="row.state == 'closed' and row.ydental_lab_contact_stage != 'stopped'">
                                            </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div><nav t-if="not focused_followup" aria-label="复诊待办分页"><a t-if="followup_page &gt; 1" t-att-href="followup_page_url(followup_page - 1)">上一页</a> 第 <t t-out="followup_page"/> 页 <a t-if="followup_more and followup_page &lt; 1000" t-att-href="followup_page_url(followup_page + 1)">下一页</a><span t-if="followup_more and followup_page == 1000">待办过多，请联系负责人处理。</span></nav><a t-if="focused_followup" href="/ydental/followups">返回复诊待办</a></section>
                <section class="card my-3">
                    <div class="card-body">
                        <h2>Notification failures and unknown outcomes</h2>
                        <p>Unknown outcomes must be reconciled before another send. A controlled test sink never proves patient delivery.</p>
                        <div class="o_ydental_access_scroll" tabindex="0" aria-label="Scrollable details"><table class="table table-sm">
                            <thead><tr><th>Event</th><th>Due</th><th>State</th><th>Request identifier</th><th>Detail</th><th>Reconcile</th></tr></thead>
                            <tbody>
                                <t t-foreach="jobs" t-as="job">
                                    <tr>
                                        <td t-out="job_type_labels[job.ydental_event_type]"/><td t-out="job.ydental_due_at"/>
                                        <td t-out="job_state_labels[job.ydental_state]"/><td t-out="job.ydental_request_id or '-'"/>
                                        <td t-out="job.ydental_last_error or ''"/>
                                        <td t-if="job.ydental_state == 'unknown'">
                                            <form action="/ydental/followups/action" method="post" t-if="can_write">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="revision" t-att-value="revision"/>
                                                <input type="hidden" name="operation" value="reconcile_unknown"/>
                                                <input type="hidden" name="job_id" t-att-value="job.id"/>
                                                <select class="form-select" name="outcome"><option value="accepted">Accepted</option><option value="delivered">Confirmed delivered</option><option value="failed">Failed</option></select>
                                                <input class="form-control" name="evidence" required="required" maxlength="300" placeholder="Query evidence or manual verification"/>
                                                <button class="btn btn-secondary" type="submit">Reconcile</button>
                                            </form>
                                        </td>
                                        <td t-else="">Manual contact required</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div></div>
                </section>
            <section class="card my-3"><details class="card-body" t-if="can_write"><summary>Patient contact settings and closed-plan actions</summary><t t-foreach="rows" t-as="row"><details t-if="can_write"><summary>Contact preference</summary>
                                            <p><strong t-out="row.ydental_patient_id.name"/><span t-out="row.ydental_patient_id.ydental_number"/></p><form action="/ydental/followups/action" method="post">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="revision" t-att-value="revision"/>
                                                <input type="hidden" name="operation" value="set_preference"/>
                                                <input type="hidden" name="patient_id" t-att-value="row.ydental_patient_id.id"/>
                                                <label><input type="checkbox" name="opt_out" value="yes"/> Opt out of automatic messages</label>
                                                <select class="form-select" name="preferred_channel"><option value="manual">Manual contact only</option><option value="phone">Telephone</option><option value="email">Email</option><option value="message">Message</option></select>
                                                <button class="btn btn-secondary" type="submit">Save preference</button>
                                            </form>
                                        </details>
                                        <details t-if="can_write and (row.state == 'closed' and row.ydental_lab_contact_stage != 'stopped')"><summary>Reopen with reason</summary>
                                                <p><strong t-out="row.ydental_patient_id.name"/><span t-out="row.ydental_patient_id.ydental_number"/></p><p><strong>Follow-up plan:</strong> <span t-out="row.name"/> · <span>Planned time (UTC):</span> <span t-out="row.ydental_planned_at"/><br/><strong>Closure reason:</strong> <span t-out="row.ydental_closed_reason or ''"/></p><form action="/ydental/followups/action" method="post">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <input type="hidden" name="revision" t-att-value="revision"/>
                                                    <input type="hidden" name="operation" value="reopen"/>
                                                    <input type="hidden" name="followup_id" t-att-value="row.id"/>
                                                    <input class="form-control" name="reason" maxlength="300" required="required" placeholder="Reason"/>
                                                    <button class="btn btn-secondary" type="submit">Reopen plan</button>
                                                </form>
                                            </details>
                                        </t></details></section></main>
        </t>
    </template>
</odoo>
