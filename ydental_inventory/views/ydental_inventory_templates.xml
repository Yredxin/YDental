<odoo>
  <record id="ydental_inventory_action" model="ir.actions.act_url">
    <field name="name">Inventory workbench</field>
    <field name="url">/ydental/inventory</field>
    <field name="target">self</field>
  </record>
  <menuitem id="ydental_inventory_menu" name="Inventory workbench" parent="ydental_base.ydental_base_menu_root" action="ydental_inventory_action" sequence="70" groups="ydental_base.ydental_base_group_user"/>
  <template id="ydental_inventory_page" name="YDental Inventory">
    <t t-set="head">
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <t t-call-assets="web.assets_frontend" t-js="false"/>
    </t>
    <t t-call="web.layout" head="head">
      <main class="container py-4 o_ydental_inventory o_ydental_access_inventory">
<h1>Inventory workbench</h1><p><a href="/ydental/access">Store and access</a> | <a href="/ydental/inventory">Inventory</a> | <a href="/ydental/inventory/catalog">Group product catalog</a></p>
<section t-if="not can_catalog or config"><h2>Find products, lots and consumption</h2><form action="/ydental/inventory" method="get"><label>Product or lot name <input name="q" maxlength="100" t-att-value="search_term"/></label><button>Search</button></form><p>Search only reads the current authorized store. Open a source to see its movement and responsibility.</p></section><h2 t-out="store.name"/><p>Native stock movements are authoritative. Suggested quantities require actual batch and quantity confirmation.</p>
<p t-if="not config or not config.ydental_policy_configured" class="alert alert-warning">Alert policy is not configured. No production thresholds are assumed.</p>
<t t-if="can_write"><details name="inventory-operation" class="o_ydental_access_operation"><summary>Configure store warehouse</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="setup" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="setup"/><h3 class="w-100">Configure store warehouse</h3><label>Warehouse code<input class="form-control" name="code" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><a href="/ydental/inventory">Cancel and return to viewing</a></details><details name="inventory-operation" class="o_ydental_access_operation"><summary>Explicit alert policy</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="policy" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="policy"/><h3 class="w-100">Explicit alert policy</h3><label>Near expiry days<input class="form-control" name="near_days" type="number" step="any" required="required"/></label><label>Collection alert days<input class="form-control" name="wait_days" type="number" step="any" required="required"/></label><label>Low stock quantity<input class="form-control" name="low_quantity" type="number" step="any" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><a href="/ydental/inventory">Cancel and return to viewing</a></details><details name="inventory-operation" class="o_ydental_access_operation"><summary>Create manufacturer lot</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="lot" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="lot"/><h3 class="w-100">Create manufacturer lot</h3><label>Product<select name="product_id" class="form-select"><t t-foreach="products" t-as="p"><option t-att-value="p['id']" t-out="p['name']"/></t></select></label><label>Manufacturer batch label<input class="form-control" name="name" type="text" required="required"/></label><label>Expiry UTC (YYYY-MM-DD HH:MM:SS)<input class="form-control" name="expiration" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><a href="/ydental/inventory">Cancel and return to viewing</a></details><details name="inventory-operation" class="o_ydental_access_operation"><summary>Actual receipt</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="receive" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="receive"/><h3 class="w-100">Actual receipt</h3><label>Actual lot<select name="lot_id" class="form-select"><t t-foreach="lots" t-as="l"><option t-att-value="l['id']" t-out="l['product'] + ' / ' + l['name']"/></t></select></label><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual quantity<input class="form-control" name="quantity" type="number" step="any" required="required"/></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><a href="/ydental/inventory">Cancel and return to viewing</a></details><details name="inventory-operation" class="o_ydental_access_operation"><summary>Actual replenishment issue</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="issue" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="issue"/><h3 class="w-100">Actual replenishment issue</h3><label>Actual lot<select name="lot_id" class="form-select"><t t-foreach="lots" t-as="l"><option t-att-value="l['id']" t-out="l['product'] + ' / ' + l['name']"/></t></select></label><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual quantity<input class="form-control" name="quantity" type="number" step="any" required="required"/></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><a href="/ydental/inventory">Cancel and return to viewing</a></details><details name="inventory-operation" class="o_ydental_access_operation"><summary>Count actual stock</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="inventory" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="inventory"/><h3 class="w-100">Count actual stock</h3><label>Actual lot<select name="lot_id" class="form-select"><t t-foreach="lots" t-as="l"><option t-att-value="l['id']" t-out="l['product'] + ' / ' + l['name']"/></t></select></label><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual counted quantity<input class="form-control" name="counted" type="number" step="any" required="required"/></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><a href="/ydental/inventory">Cancel and return to viewing</a></details><details name="inventory-operation" class="o_ydental_access_operation"><summary>Same company transfer</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="transfer" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="transfer"/><h3 class="w-100">Same company transfer</h3><label>Actual lot<select name="lot_id" class="form-select"><t t-foreach="lots" t-as="l"><option t-att-value="l['id']" t-out="l['product'] + ' / ' + l['name']"/></t></select></label><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual quantity<input class="form-control" name="quantity" type="number" step="any" required="required"/></label><label>Target store<select name="target_store_id" class="form-select"><t t-foreach="stores" t-as="st"><option t-att-value="st.id" t-out="st.name"/></t></select></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><a href="/ydental/inventory">Cancel and return to viewing</a></details><details name="inventory-operation" class="o_ydental_access_operation"><summary>Enable or disable store lot</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="lot_edit" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="lot_edit"/><h3 class="w-100">Enable or disable store lot</h3><label>Actual lot<select name="lot_id" class="form-select"><t t-foreach="lots" t-as="l"><option t-att-value="l['id']" t-out="l['product'] + ' / ' + l['name']"/></t></select></label><label>Enabled<select name="enabled"><option value="yes">Yes</option><option value="no">No</option></select></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><a href="/ydental/inventory">Cancel and return to viewing</a></details></t><t t-if="can_catalog"><details name="inventory-operation" class="o_ydental_access_operation"><summary>Group inventory product</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="product" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="product"/><h3 class="w-100">Group inventory product</h3><label>Product code<input class="form-control" name="code" type="text" required="required"/></label><label>Product name<input class="form-control" name="name" type="text" required="required"/></label><label>Specification<input class="form-control" name="specification" type="text" required="required"/></label><label>Business location<select name="kind"><option value="medicine">Pharmacy</option><option value="material">Materials</option><option value="prosthesis">Prosthesis awaiting collection</option></select></label><label>Stock unit<select name="stock_uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Issue unit<select name="issue_uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Minimum stock step<input class="form-control" name="step" type="number" step="any" required="required"/></label><label>Suggested quantity only<input class="form-control" name="suggested" type="number" step="any" value="0" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><a href="/ydental/inventory">Cancel and return to viewing</a></details><details name="inventory-operation" class="o_ydental_access_operation"><summary>Product lifecycle</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="product_edit" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="product_edit"/><h3 class="w-100">Product lifecycle</h3><label>Product<select name="product_id" class="form-select"><t t-foreach="products" t-as="p"><option t-att-value="p['id']" t-out="p['name']"/></t></select></label><label>Product name<input class="form-control" name="name" type="text" required="required"/></label><label>Active<select name="active"><option value="yes">Yes</option><option value="no">No</option></select></label><button type="submit" class="btn btn-primary">Confirm</button></form><a href="/ydental/inventory">Cancel and return to viewing</a></details></t><h2>Lots and alerts</h2><div class="o_ydental_access_scroll" tabindex="0" aria-label="Scrollable details"><table class="table"><thead><tr><th>Product</th><th>Lot</th><th>Business location</th><th>On hand</th><th>Available</th><th>Quarantine</th><th>Expiry UTC</th><th>Actual receipt UTC</th><th>Alerts</th></tr></thead><tbody>
<tr t-foreach="visible_lots" t-as="l" t-att-data-lot="l['id']" t-att-id="'lot-%s' % l['id']"><td t-out="l['product']"/><td t-out="l['name']"/><td t-out="kind_labels[l['kind']]"/><td t-out="l['on_hand']"/><td class="available" t-out="l['quantity']"/><td class="quarantine" t-out="l['quarantine']"/><td t-out="l['expiration']"/><td t-out="l['received_at']"/><td t-att-data-flags="','.join(l['flags'])" t-out="', '.join(flag_labels[f] for f in l['flags'])"/></tr></tbody></table>
</div><h2>Inventory sources and recovery</h2><article t-foreach="events" t-as="e" t-att-data-event="e['id']" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3" t-att-id="'event-%s' % e['id']"><h3 class="w-100"><span t-out="kind_labels[e['kind']]"/> / <span t-out="e['product']"/> / <span class="event-state" t-att-data-state="e['state']" t-out="state_labels[e['state']]"/></h3><a t-att-href="'/ydental/inventory?event_id=%s#event-%s' % (e['id'], e['id'])">Open this source</a><p><span t-out="e['quantity']"/> / <span t-out="e['lot']"/> / <span t-out="e['responsible']"/></p><p t-out="e['summary']"/><p t-if="e['synthetic']" class="alert alert-info">Synthetic validation source. Real clinical integration is not connected.</p><p>Native movement: <span class="move-id" t-out="e['move_id']"/></p><t t-if="can_write">
<t t-if="e['kind'] in ('replenishment','prescription') and e['state'] == 'done'"><details name="inventory-operation"><summary>Enter stock action</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="return" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="return"/><h4>Register physical return</h4><input type="hidden" name="event_id" t-att-value="e['id']"/><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual quantity<input class="form-control" name="quantity" type="number" step="any" required="required"/></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form></details></t><t t-if="e['kind'] == 'return'"><details name="inventory-operation"><summary>Enter stock action</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="verify" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="verify"/><h4>Verify physical destination</h4><input type="hidden" name="event_id" t-att-value="e['id']"/><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual quantity<input class="form-control" name="quantity" type="number" step="any" required="required"/></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Verified destination<select name="disposition"><option value="release">Release to issuable stock</option><option value="discard">Discard as actual loss</option></select></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form></details></t><t t-if="e['state'] == 'pending'"><details name="inventory-operation"><summary>Enter stock action</summary><form action="/ydental/inventory/action" method="post" data-inventory-form="recover" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="recover"/><h4>Recover original event</h4><input type="hidden" name="event_id" t-att-value="e['id']"/><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form></details></t></t></article><h2>Identify scan source</h2><form action="/ydental/inventory/scan" method="post" data-inventory-form="scan"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/><label>Code<input name="code" required="required"/></label><button type="submit">Identify only</button></form><p>Scanning does not authorize receipt. Outsourcing integration is not connected.</p><nav t-if="not can_catalog or config"><a t-if="search_page &gt; 1" t-att-href="search_url(search_page - 1)">Previous source page</a><span> <t t-out="search_page"/> </span><a t-if="has_more_events" t-att-href="search_url(search_page + 1)">Next source page</a></nav></main>
    </t>
  </template>
  <template id="ydental_inventory_error" name="Inventory action result">
    <t t-set="head">
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <t t-call-assets="web.assets_frontend" t-js="false"/>
    </t>
    <t t-call="web.layout" head="head">
      <main class="container py-4">
        <h1>Inventory action refused</h1>
        <p class="alert alert-warning" t-out="message"/>
        <a href="/ydental/inventory">Return to inventory workbench</a>
      </main>
    </t>
  </template>
</odoo>
