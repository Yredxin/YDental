<odoo><template id="ydental_inventory_page" name="YDental Inventory"><t t-call="web.layout"><main class="container py-4 o_ydental_inventory">
<h1>Inventory workbench</h1><p><a href="/ydental/access">Store and access</a> | <a href="/ydental/inventory">Inventory</a> | <a href="/ydental/inventory/catalog">Group product catalog</a></p>
<h2 t-out="store.name"/><p>Native stock movements are authoritative. Suggested quantities require actual batch and quantity confirmation.</p>
<p t-if="not config or not config.ydental_policy_configured" class="alert alert-warning">Alert policy is not configured. No production thresholds are assumed.</p>
<t t-if="can_write"><form action="/ydental/inventory/action" method="post" data-inventory-form="setup" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="setup"/><h3>Configure store warehouse</h3><label>Warehouse code<input class="form-control" name="code" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><form action="/ydental/inventory/action" method="post" data-inventory-form="policy" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="policy"/><h3>Explicit alert policy</h3><label>Near expiry days<input class="form-control" name="near_days" type="number" step="any" required="required"/></label><label>Collection alert days<input class="form-control" name="wait_days" type="number" step="any" required="required"/></label><label>Low stock quantity<input class="form-control" name="low_quantity" type="number" step="any" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><form action="/ydental/inventory/action" method="post" data-inventory-form="lot" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="lot"/><h3>Create manufacturer lot</h3><label>Product<select name="product_id" class="form-select"><t t-foreach="products" t-as="p"><option t-att-value="p['id']" t-out="p['name']"/></t></select></label><label>Manufacturer batch label<input class="form-control" name="name" type="text" required="required"/></label><label>Expiry UTC (YYYY-MM-DD HH:MM:SS)<input class="form-control" name="expiration" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><form action="/ydental/inventory/action" method="post" data-inventory-form="receive" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="receive"/><h3>Actual receipt</h3><label>Actual lot<select name="lot_id" class="form-select"><t t-foreach="lots" t-as="l"><option t-att-value="l['id']" t-out="l['product'] + ' / ' + l['name']"/></t></select></label><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual quantity<input class="form-control" name="quantity" type="number" step="any" required="required"/></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><form action="/ydental/inventory/action" method="post" data-inventory-form="issue" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="issue"/><h3>Actual replenishment issue</h3><label>Actual lot<select name="lot_id" class="form-select"><t t-foreach="lots" t-as="l"><option t-att-value="l['id']" t-out="l['product'] + ' / ' + l['name']"/></t></select></label><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual quantity<input class="form-control" name="quantity" type="number" step="any" required="required"/></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><form action="/ydental/inventory/action" method="post" data-inventory-form="inventory" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="inventory"/><h3>Count actual stock</h3><label>Actual lot<select name="lot_id" class="form-select"><t t-foreach="lots" t-as="l"><option t-att-value="l['id']" t-out="l['product'] + ' / ' + l['name']"/></t></select></label><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual counted quantity<input class="form-control" name="counted" type="number" step="any" required="required"/></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><form action="/ydental/inventory/action" method="post" data-inventory-form="transfer" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="transfer"/><h3>Same company transfer</h3><label>Actual lot<select name="lot_id" class="form-select"><t t-foreach="lots" t-as="l"><option t-att-value="l['id']" t-out="l['product'] + ' / ' + l['name']"/></t></select></label><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual quantity<input class="form-control" name="quantity" type="number" step="any" required="required"/></label><label>Target store<select name="target_store_id" class="form-select"><t t-foreach="stores" t-as="st"><option t-att-value="st.id" t-out="st.name"/></t></select></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><form action="/ydental/inventory/action" method="post" data-inventory-form="lot_edit" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="lot_edit"/><h3>Enable or disable store lot</h3><label>Actual lot<select name="lot_id" class="form-select"><t t-foreach="lots" t-as="l"><option t-att-value="l['id']" t-out="l['product'] + ' / ' + l['name']"/></t></select></label><label>Enabled<select name="enabled"><option value="yes">Yes</option><option value="no">No</option></select></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form></t><t t-if="can_catalog"><form action="/ydental/inventory/action" method="post" data-inventory-form="product" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="product"/><h3>Group inventory product</h3><label>Product code<input class="form-control" name="code" type="text" required="required"/></label><label>Product name<input class="form-control" name="name" type="text" required="required"/></label><label>Specification<input class="form-control" name="specification" type="text" required="required"/></label><label>Business location<select name="kind"><option value="medicine">Pharmacy</option><option value="material">Materials</option><option value="prosthesis">Prosthesis awaiting collection</option></select></label><label>Stock unit<select name="stock_uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Issue unit<select name="issue_uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Minimum stock step<input class="form-control" name="step" type="number" step="any" required="required"/></label><label>Suggested quantity only<input class="form-control" name="suggested" type="number" step="any" value="0" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form><form action="/ydental/inventory/action" method="post" data-inventory-form="product_edit" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="product_edit"/><h3>Product lifecycle</h3><label>Product<select name="product_id" class="form-select"><t t-foreach="products" t-as="p"><option t-att-value="p['id']" t-out="p['name']"/></t></select></label><label>Product name<input class="form-control" name="name" type="text" required="required"/></label><label>Active<select name="active"><option value="yes">Yes</option><option value="no">No</option></select></label><button type="submit" class="btn btn-primary">Confirm</button></form></t><h2>Lots and alerts</h2><table class="table"><thead><tr><th>Product</th><th>Lot</th><th>Business location</th><th>Available</th><th>Quarantine</th><th>Expiry UTC</th><th>Actual receipt UTC</th><th>Alerts</th></tr></thead><tbody>
<tr t-foreach="lots" t-as="l" t-att-data-lot="l['id']"><td t-out="l['product']"/><td t-out="l['name']"/><td t-out="l['kind']"/><td class="available" t-out="l['quantity']"/><td class="quarantine" t-out="l['quarantine']"/><td t-out="l['expiration']"/><td t-out="l['received_at']"/><td t-out="', '.join(l['flags'])"/></tr></tbody></table>
<h2>Inventory sources and recovery</h2><article t-foreach="events" t-as="e" t-att-data-event="e['id']" class="border p-3 mb-3"><h3><span t-out="e['kind']"/> / <span t-out="e['product']"/> / <span class="event-state" t-out="e['state']"/></h3><p><span t-out="e['quantity']"/> / <span t-out="e['lot']"/> / <span t-out="e['responsible']"/></p><p t-out="e['summary']"/><p t-if="e['synthetic']" class="alert alert-info">Synthetic validation source. Real clinical integration is not connected.</p><p>Native movement: <span class="move-id" t-out="e['move_id']"/></p><t t-if="can_write">
<t t-if="e['kind'] in ('replenishment','treatment','chairside','prescription') and e['state'] == 'done'"><form action="/ydental/inventory/action" method="post" data-inventory-form="return" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="return"/><h4>Register physical return</h4><input type="hidden" name="event_id" t-att-value="e['id']"/><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual quantity<input class="form-control" name="quantity" type="number" step="any" required="required"/></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form></t><t t-if="e['kind'] == 'return'"><form action="/ydental/inventory/action" method="post" data-inventory-form="verify" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="verify"/><h4>Verify physical destination</h4><input type="hidden" name="event_id" t-att-value="e['id']"/><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual quantity<input class="form-control" name="quantity" type="number" step="any" required="required"/></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Verified destination<select name="disposition"><option value="release">Release to issuable stock</option><option value="discard">Discard as actual loss</option></select></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form></t><t t-if="e['state'] == 'pending'"><form action="/ydental/inventory/action" method="post" data-inventory-form="recover" class="border p-3 mb-3">
<input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/>
<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="recover"/><h4>Recover original event</h4><input type="hidden" name="event_id" t-att-value="e['id']"/><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" class="btn btn-primary">Confirm</button></form></t></t></article><h2>Identify scan source</h2><form action="/ydental/inventory/scan" method="post" data-inventory-form="scan"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/><label>Code<input name="code" required="required"/></label><button type="submit">Identify only</button></form><p>Scanning does not authorize receipt. Outsourcing integration is not connected.</p></main></t></template></odoo>