<input type="hidden" name="key" t-att-value="key()"/><input type="hidden" name="operation" value="return"/><h4>Register physical return</h4><input type="hidden" name="event_id" t-att-value="e['id']"/><label>Confirmed unit<select name="uom_id" class="form-select"><t t-foreach="units" t-as="u"><option t-att-value="u.id" t-out="u.name"/></t></select></label><label>Actual quantity<input class="form-control" name="quantity" type="number" step="any" required="required"/></label><label>Unique source reference<input class="form-control" name="source_key" type="text" required="required"/></label><label>Evidence and reason<input class="form-control" name="reason" type="text" required="required"/></label><button type="submit" t-att-class="'o_ydental_inventory_action o_ydental_inventory_action_primary' if inventory_lookup else 'btn btn-primary'" t-att-data-dl-actions="'inventory-actions' if inventory_lookup else None"><t t-if="inventory_lookup"><span class="o_ydental_inventory_action_label">Confirm</span></t><t t-else="">Confirm</t></button></form></details></t><t t-if="e['kind'] == 'return'"><details name="inventory-operation"><summary t-att-class="'o_ydental_inventory_disclosure' if inventory_lookup else None" t-att-data-dl-actions="'inventory-actions' if inventory_lookup else None"><t t-if="inventory_lookup"><span class="o_ydental_inventory_action_label">Enter stock action</span></t><t t-else="">Enter stock action</t></summary><form action="/ydental/inventory/action" method="post" data-inventory-form="verify" class="border rounded p-3 mb-3 d-flex flex-wrap align-items-end gap-3">
