  <template id="ydental_inventory_error" name="Inventory action result">
    <t t-set="head">
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <t t-call-assets="web.assets_frontend" t-js="false"/>
    </t>
    <t t-call="web.layout" head="head">
      <main class="container py-4">
        <h1>Inventory action refused</h1>
