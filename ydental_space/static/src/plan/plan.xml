<templates xml:space="preserve">
    <t t-name="ydental_space.Plan">
        <div class="o_ydental_space_plan">
            <div class="o_ydental_space_toolbar">
                <h2>Clinic floor plan</h2>
                <select aria-label="Floor" t-on-change="this.changeFloor" t-att-value="this.state.data?.floor.id">
                    <option t-foreach="this.state.floors" t-as="floor" t-key="floor.id" t-att-value="floor.id" t-out="floor.name"/>
                </select>
                <button class="btn btn-secondary" t-on-click="this.newFloor" t-att-disabled="this.state.data &amp;&amp; !this.state.data.writable">New floor</button>
                <t t-if="this.state.data">
                    <span t-out="this.state.data.floor.ydental_store_id[1]"/>
                    <strong t-if="!this.state.data.writable">Read only</strong>
                    <button class="btn btn-primary" t-on-click="this.save" t-att-disabled="!this.state.data.writable || this.state.busy">Save layout</button>
                    <button class="btn btn-secondary" t-on-click="() =&gt; this.run(() =&gt; this.load(this.state.data.floor.id))" t-att-disabled="this.state.busy">Reload</button>
                    <label>Zoom <input aria-label="Zoom" type="range" min="0.4" max="2" step="0.1" t-att-value="this.state.zoom" t-on-input="(event) =&gt; { this.state.zoom = Number(event.target.value); }"/></label>
                </t>
            </div>
            <p t-if="!this.state.data">Create a floor to begin.</p>
            <div t-else="" class="o_ydental_space_content">
                <aside class="o_ydental_space_sidebar">
                    <p>Execution status not connected</p>
                    <p>Configure areas and equipment. Runtime status will be connected in S06.</p>
                    <select aria-label="Drawing tool" t-att-disabled="!this.state.data.writable || this.state.busy" t-att-value="this.state.mode" t-on-change="(event) =&gt; { this.state.mode = event.target.value; }">
                        <option value="select">Select and move</option><option value="rect">Draw rectangle</option><option value="polygon">Draw polygon</option>
                    </select>
                    <button t-if="this.state.mode === 'polygon'" class="btn btn-secondary" t-on-click="this.finishPolygon">Finish polygon</button>
                    <h3>Resource library</h3>
                    <p>Drag equipment into a selected area. Select an existing workstation to add another resource.</p>
                    <div class="o_ydental_space_resources">
                        <div t-foreach="this.state.data.resources" t-as="resource" t-key="resource.id" t-att-draggable="this.state.data.writable" t-on-dragstart="(event) =&gt; this.dragResource(event, resource)">
                            <img t-att-src="'/ydental/space/resource/' + resource.id + '.svg'" alt=""/><span t-out="resource.name"/>
                        </div>
                    </div>
                    <t t-set="selected" t-value="this.selected()"/>
                    <t t-if="selected">
                        <h3 t-out="selected.name"/>
                        <p>Stable ID: <span t-out="selected.id"/></p>
                        <label>Width <input aria-label="Width" type="number" t-att-value="selected.ydental_width" t-on-change="(event) =&gt; this.changeGeometry(event, 'ydental_width')" t-att-disabled="!this.state.data.writable"/></label>
                        <label>Height <input aria-label="Height" type="number" t-att-value="selected.ydental_height" t-on-change="(event) =&gt; this.changeGeometry(event, 'ydental_height')" t-att-disabled="!this.state.data.writable"/></label>
                        <label>Direction <input aria-label="Direction" type="number" t-att-value="selected.ydental_angle" t-on-change="(event) =&gt; this.changeGeometry(event, 'ydental_angle')" t-att-disabled="!this.state.data.writable"/></label>
                        <button class="btn btn-secondary" t-on-click="this.configure">Name, area and capabilities</button>
                        <p t-if="selected.ydental_capability_ids">Capabilities: <span t-out="selected.ydental_capability_ids.map((id) =&gt; this.state.data.capabilities.find((capability) =&gt; capability.id === id)?.name).join(', ')"/></p>
                    </t>
                </aside>
                <div class="o_ydental_space_canvas_scroll">
                    <svg t-ref="this.canvas" class="o_ydental_space_canvas" t-att-width="this.state.data.floor.ydental_width * this.state.zoom" t-att-height="this.state.data.floor.ydental_height * this.state.zoom" t-att-viewBox="'0 0 ' + this.state.data.floor.ydental_width + ' ' + this.state.data.floor.ydental_height" t-on-pointerdown="this.pointerDown" t-on-pointermove="this.pointerMove" t-on-pointerup="this.pointerUp" t-on-pointercancel="() =&gt; { this.drag = null; this.state.drawing = null; }" t-on-dragover.prevent="() =&gt; {}" t-on-drop="this.dropResource">
                        <g t-foreach="this.objects()" t-as="object" t-key="object.kind + ':' + object.id" t-att-transform="this.transform(object)" t-att-class="'o_ydental_space_object o_ydental_space_' + object.kind + (this.state.selected === object.kind + ':' + object.id ? ' o_ydental_space_selected' : '')" t-att-data-kind="object.kind" t-att-data-id="object.id" t-on-pointerdown="(event) =&gt; this.select(event, object)">
                            <title t-out="object.name"/>
                            <polygon t-if="object.kind === 'area' &amp;&amp; object.ydental_shape === 'polygon'" t-att-points="this.points(object)"/>
                            <rect t-else="" t-att-width="object.ydental_width" t-att-height="object.ydental_height" rx="4"/>
                            <image t-if="object.kind === 'item'" t-att-href="'/ydental/space/resource/' + object.ydental_resource_id[0] + '.svg'" t-att-width="object.ydental_width" t-att-height="object.ydental_height"/>
                            <text x="6" y="18" t-out="object.name"/>
                        </g>
                        <rect t-if="this.state.drawing" class="o_ydental_space_drawing" t-att-x="Math.min(this.state.drawing.x, this.state.drawing.x + this.state.drawing.width)" t-att-y="Math.min(this.state.drawing.y, this.state.drawing.y + this.state.drawing.height)" t-att-width="Math.abs(this.state.drawing.width)" t-att-height="Math.abs(this.state.drawing.height)"/>
                        <polyline t-if="this.state.polygon.length" class="o_ydental_space_drawing" t-att-points="this.state.polygon.map((point) =&gt; point.join(',')).join(' ')"/>
                    </svg>
                </div>
            </div>
        </div>
    </t>
</templates>
