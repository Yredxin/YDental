<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="ydental_space_plan_action" model="ir.actions.client">
        <field name="name">Clinic floor plan</field>
        <field name="tag">ydental_space.plan</field>
    </record>
    <menuitem id="ydental_space_menu" name="Clinic space" parent="ydental_base.ydental_base_menu_root" sequence="30"/>
    <menuitem id="ydental_space_plan_menu" name="Floor plan" parent="ydental_space_menu" action="ydental_space_plan_action" sequence="1"/>
    <record id="ydental_space_floor_view_list" model="ir.ui.view">
        <field name="name">ydental.space.floor.list</field>
        <field name="model">ydental.space.floor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
                <field name="ydental_store_id"/>
                <field name="ydental_version"/>
            </list>
        </field>
    </record>
    <record id="ydental_space_floor_view_form" model="ir.ui.view">
        <field name="name">ydental.space.floor.form</field>
        <field name="model">ydental.space.floor</field>
        <field name="arch" type="xml">
            <form js_class="ydental_space_form">
                <header>
                    <button name="action_plan" type="object" string="Open floor plan" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="ydental_store_id" required="1"/>
                        <field name="ydental_version" readonly="1"/>
                        <field name="ydental_width"/>
                        <field name="ydental_height"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ydental_space_floor_action" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">ydental.space.floor</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="ydental_space_floor_menu" name="Floors" parent="ydental_space_menu" action="ydental_space_floor_action"/>
    <record id="ydental_space_area_view_list" model="ir.ui.view">
        <field name="name">ydental.space.area.list</field>
        <field name="model">ydental.space.area</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
                <field name="ydental_store_id"/>
                <field name="ydental_version"/>
            </list>
        </field>
    </record>
    <record id="ydental_space_area_view_form" model="ir.ui.view">
        <field name="name">ydental.space.area.form</field>
        <field name="model">ydental.space.area</field>
        <field name="arch" type="xml">
            <form js_class="ydental_space_form">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="ydental_store_id" required="1"/>
                        <field name="ydental_version" readonly="1"/>
                        <field name="ydental_floor_id"/>
                        <field name="parent_id"/>
                        <field name="ydental_purpose"/>
                        <field name="ydental_reporting"/>
                        <field name="ydental_prefix"/>
                        <field name="ydental_missed_limit"/>
                        <field name="ydental_queue_area_id"/>
                        <field name="ydental_capability_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="ydental_shape"/>
                        <field name="ydental_points"/>
                        <field name="ydental_x"/>
                        <field name="ydental_y"/>
                        <field name="ydental_width"/>
                        <field name="ydental_height"/>
                        <field name="ydental_angle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ydental_space_area_action" model="ir.actions.act_window">
        <field name="name">Areas</field>
        <field name="res_model">ydental.space.area</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="ydental_space_area_menu" name="Areas" parent="ydental_space_menu" action="ydental_space_area_action"/>
    <record id="ydental_space_station_view_list" model="ir.ui.view">
        <field name="name">ydental.space.station.list</field>
        <field name="model">ydental.space.station</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
                <field name="ydental_store_id"/>
                <field name="ydental_version"/>
            </list>
        </field>
    </record>
    <record id="ydental_space_station_view_form" model="ir.ui.view">
        <field name="name">ydental.space.station.form</field>
        <field name="model">ydental.space.station</field>
        <field name="arch" type="xml">
            <form js_class="ydental_space_form">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="ydental_store_id" required="1"/>
                        <field name="ydental_version" readonly="1"/>
                        <field name="ydental_floor_id"/>
                        <field name="ydental_area_id"/>
                        <field name="ydental_queue_area_id"/>
                        <field name="ydental_kind"/>
                        <field name="ydental_callable"/>
                        <field name="ydental_enabled"/>
                        <field name="ydental_add_capability_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="ydental_remove_capability_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="ydental_capability_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="ydental_x"/>
                        <field name="ydental_y"/>
                        <field name="ydental_width"/>
                        <field name="ydental_height"/>
                        <field name="ydental_angle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ydental_space_station_action" model="ir.actions.act_window">
        <field name="name">Workstations</field>
        <field name="res_model">ydental.space.station</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="ydental_space_station_menu" name="Workstations" parent="ydental_space_menu" action="ydental_space_station_action"/>
    <record id="ydental_space_item_view_list" model="ir.ui.view">
        <field name="name">ydental.space.item.list</field>
        <field name="model">ydental.space.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
                <field name="ydental_store_id"/>
                <field name="ydental_version"/>
            </list>
        </field>
    </record>
    <record id="ydental_space_item_view_form" model="ir.ui.view">
        <field name="name">ydental.space.item.form</field>
        <field name="model">ydental.space.item</field>
        <field name="arch" type="xml">
            <form js_class="ydental_space_form">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="ydental_store_id" required="1"/>
                        <field name="ydental_version" readonly="1"/>
                        <field name="ydental_floor_id"/>
                        <field name="ydental_resource_id"/>
                        <field name="ydental_station_id"/>
                        <field name="ydental_x"/>
                        <field name="ydental_y"/>
                        <field name="ydental_width"/>
                        <field name="ydental_height"/>
                        <field name="ydental_angle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ydental_space_item_action" model="ir.actions.act_window">
        <field name="name">Placed artwork</field>
        <field name="res_model">ydental.space.item</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="ydental_space_item_menu" name="Placed artwork" parent="ydental_space_menu" action="ydental_space_item_action"/>
    <record id="ydental_space_resource_view_list" model="ir.ui.view">
        <field name="name">ydental.space.resource.list</field>
        <field name="model">ydental.space.resource</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
                <field name="ydental_store_id"/>
                <field name="ydental_version"/>
            </list>
        </field>
    </record>
    <record id="ydental_space_resource_view_form" model="ir.ui.view">
        <field name="name">ydental.space.resource.form</field>
        <field name="model">ydental.space.resource</field>
        <field name="arch" type="xml">
            <form js_class="ydental_space_form">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="ydental_store_id"/>
                        <field name="ydental_version" readonly="1"/>
                        <field name="ydental_kind"/>
                        <field name="ydental_capability_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="ydental_upload"/>
                        <field name="ydental_svg" required="not ydental_upload"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ydental_space_resource_action" model="ir.actions.act_window">
        <field name="name">Resource library</field>
        <field name="res_model">ydental.space.resource</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="ydental_space_resource_menu" name="Resource library" parent="ydental_space_menu" action="ydental_space_resource_action"/>
</odoo>
