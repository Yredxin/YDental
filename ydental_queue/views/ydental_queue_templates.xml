<odoo>
    <record id="ydental_queue_action" model="ir.actions.act_url">
        <field name="name">Workstation queue</field><field name="url">/ydental/queue</field><field name="target">self</field>
    </record>
    <menuitem id="ydental_queue_menu" name="Workstation queue" parent="ydental_base.ydental_base_menu_root" action="ydental_queue_action" sequence="60" groups="ydental_base.ydental_base_group_user"/>
    <template id="ydental_queue_page" name="Workstation queue">
        <t t-set="head"><meta name="viewport" content="width=device-width, initial-scale=1"/><t t-call-assets="web.assets_frontend" t-js="false"/><script type="module" src="/ydental_queue/static/src/workspace/workspace.js"/></t>
        <t t-call="web.layout" head="head">
            <main class="container py-4 o_ydental_queue_workspace" t-att-data-lang="screen_lang" t-att-data-revision="revision" t-att-data-can-write="'yes' if can_write else 'no'" t-att-data-heartbeat="heartbeat">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <h1>Workstation queue</h1>
                <nav><a href="/ydental/access">Store and permissions</a> | <a href="/ydental/intake">Arrival and reporting</a> | <a href="/ydental/supply/today">My assignments</a></nav>
                <p>Current store: <strong t-out="store.name"/>. Workstation position: <span id="position" t-att-data-state="status['state']"><t t-out="status['store'] or '-'"/> / <t t-out="status['area'] or '-'"/> / <t t-out="status['station'] or '-'"/> (<t t-out="status.get('state_label', status['state'])"/>)</span></p>
                <p t-out="config_hint"/><p t-if="shift_hint" t-out="shift_hint"/>
                <p>Only the holding browser renews a connection. Shift end does not release it. Serving disconnection requires on-site verification.</p>
                <p id="queue-result" role="status"/>
                <span hidden="hidden" id="expired-message">Connection expired. Refresh to review queue or on-site verification.</span>
                <span hidden="hidden" id="offline-message">Connection unavailable. No success confirmed. Refresh before retrying.</span>
                <div t-if="own" t-att-data-lease="own.id" id="holding-workstation">
                    <p>Current holder: <t t-out="own.ydental_actor_id.name"/>. Connection expires: <t t-out="own.ydental_expires_at"/> UTC.</p>
                    <t t-if="can_write">
                        <button type="button" data-operation="heartbeat">Renew holding connection</button>
                        <button type="button" data-operation="call" t-att-disabled="not can_call or None">Call next matching task</button>
                        <button type="button" data-operation="exit">Exit / rest / logout workstation</button>
                    </t>
                </div>
                <span hidden="hidden" id="screen-open-message">Open this read-only area screen</span>
                <section id="business-management">
                    <h2>Local business day and area reception</h2>
                    <div t-foreach="business_rows" t-as="b" t-att-data-business-area="b['area'].id">
                        <strong t-out="b['area'].name"/> / <span class="business-state" t-out="b['business'].state if b['business'] else 'closed'"/>
                        <t t-if="can_capacity">
                            <form data-queue-form="business">
                                <input type="hidden" name="area_id" t-att-value="b['area'].id"/>
                                <input t-if="b['business']" type="hidden" name="version" t-att-value="b['business'].ydental_version"/>
                                <select name="state"><option value="open">Open / reopen</option><option value="draining">Stop ordinary reporting</option><option value="closed">Close after clearing waiting and calling</option></select>
                                <label>Business reason <input name="reason" required="required" maxlength="300"/></label><button type="submit">Apply area business state</button>
                            </form>
                            <form data-queue-form="screen_create"><input type="hidden" name="area_id" t-att-value="b['area'].id"/><button type="submit">Create read-only screen credential</button></form>
                        </t>
                    </div>
                    <form t-foreach="screen_credentials" t-as="credential" t-if="credential.state == 'active'" data-queue-form="screen_revoke">
                        <span t-out="credential.ydental_area_id.name"/><input type="hidden" name="credential_id" t-att-value="credential.id"/><button type="submit">Revoke screen credential</button>
                    </form>
                </section>
                <section id="patient-return-actions">
                    <div t-if="execution and own and can_write" t-att-data-execution="execution.id">
                        <h2>Current execution segment</h2>
                        <p>Patient task: <t t-out="execution.ydental_task_id.id"/>. Save must succeed on the server before handover.</p>
                        <form data-queue-form="handover"><input type="hidden" name="execution_id" t-att-value="execution.id"/>
                            <button type="submit">Save and hand over this segment</button></form>
                        <form t-if="return_targets" data-queue-form="reserve">
                            <input type="hidden" name="execution_id" t-att-value="execution.id"/>
                            <label>Explicit external task <select name="target_task_id"><option t-foreach="return_targets" t-as="target" t-att-value="target.id"><t t-out="target.id"/> / <t t-out="target.name"/></option></select></label>
                            <button type="submit">Reserve workstation for external service</button>
                        </form>
                    </div>
                    <div t-if="actor_hold" t-att-data-hold="actor_hold.id">
                        <h2>Reserved return</h2><p><t t-out="status.get('state_label', actor_hold.state)"/> / <t t-out="actor_hold.ydental_station_id.name"/></p>
                        <t t-if="actor_hold.state == 'active' and own and can_write">
                            <form data-queue-form="restore"><input type="hidden" name="hold_id" t-att-value="actor_hold.id"/>
                                <label><input type="checkbox" name="confirmed" required="required"/> I see the patient actually returned</label>
                                <button type="submit">Confirm return and resume</button></form>
                            <form data-queue-form="handover"><input type="hidden" name="execution_id" t-att-value="actor_hold.ydental_execution_id.id"/>
                                <button type="submit">Save and hand over reserved segment</button></form>
                        </t>
                    </div>
                    <form data-queue-form="query_return"><label>Patient ID for return query <input type="number" name="patient_id" min="1" required="required"/></label>
                        <button type="submit">Query return destination</button></form>
                </section>
                <section id="onsite-verifications" t-if="verifications">
                    <h2>Handle on-site verification</h2>
                    <p>Be physically present at the original workstation. A server save must succeed before a new holding connection is issued.</p>
                    <form t-foreach="verifications" t-as="verification" t-att-data-queue-form="verification['operation']" t-att-data-verify-execution="verification['execution'].id">
                        <p><t t-out="verification['station'].name"/> / <t t-out="verification['execution'].ydental_lease_id.ydental_actor_id.name"/> / <t t-out="verification['execution'].ydental_task_id.id"/></p>
                        <input type="hidden" name="execution_id" t-att-value="verification['execution'].id"/>
                        <label><input type="checkbox" name="confirmed" required="required"/> I am physically present at this original workstation</label>
                        <label>On-site handling reason <input name="reason" required="required" maxlength="1000"/></label>
                        <button t-if="verification['operation'] == 'takeover_verify'" type="submit">Save and take over actual execution</button>
                        <button t-else="" type="submit">Save reserved segment and create continuation</button>
                    </form>
                </section>
                <section id="continuation-reception">
                    <h2>Pending explicit tasks</h2>
                    <p>Continuation keeps the outpatient service requirements. Independent services need a new qualification.</p>
                    <div t-foreach="pending_tasks" t-as="task" t-att-data-pending-task="task.id">
                        <span><t t-out="task.id"/> / <t t-out="task.name"/> / <t t-out="task.state"/></span>
                        <form t-if="can_frontdesk" data-queue-form="report"><input type="hidden" name="task_id" t-att-value="task.id"/><input type="hidden" name="version" t-att-value="task.ydental_version"/>
                            <button type="submit">Report this explicit task</button></form>
                        <form t-if="can_append" data-queue-form="append"><input type="hidden" name="task_id" t-att-value="task.id"/>
                            <label>Append reason <input name="reason" required="required" maxlength="1000"/></label><button type="submit">Authorize task append</button></form>
                    </div>
                    <div t-foreach="permits" t-as="permit" t-att-data-permit="permit.id"><span><t t-out="permit.ydental_task_id.id"/> / <t t-out="permit.state"/></span>
                        <form t-if="can_append and permit.state == 'active'" data-queue-form="revoke"><input type="hidden" name="permit_id" t-att-value="permit.id"/>
                            <label>Revoke reason <input name="reason" required="required" maxlength="1000"/></label><button type="submit">Revoke append permit</button></form>
                    </div>
                </section>
                <h2>Workstations</h2>
                <table class="table"><thead><tr><th>Station</th><th>Area</th><th>Exact capabilities</th><th>Availability and action</th></tr></thead>
                    <tbody><tr t-foreach="stations" t-as="station" t-att-data-station="station['id']">
                        <td t-out="station['name']"/><td t-out="station['area']"/><td t-out="station['capabilities']"/>
                        <td><span t-out="station['reason']"/> <button t-if="station['can_enter']" type="button" t-att-data-operation="'switch' if own else 'enter'" t-att-data-station="station['id']"><t t-if="own">Switch to this idle workstation</t><t t-else="">Enter workstation</t></button></td>
                    </tr></tbody>
                </table>
                <h2>Accepted tasks</h2>
                <table class="table"><thead><tr><th>Number / task</th><th>Area / capability</th><th>State</th><th>Missed</th><th>Opportunity</th><th>Staffing / action</th></tr></thead>
                    <tbody><tr t-foreach="rows" t-as="row" t-att-data-entry="row['entry'].id" t-att-data-task="row['entry'].ydental_task_id.id">
                        <t t-set="entry" t-value="row['entry']"/>
                        <td><t t-out="entry.ydental_number"/> / <t t-out="entry.ydental_task_id.id"/></td>
                        <td><t t-out="entry.ydental_area_id.name"/> / <t t-out="entry.ydental_capability_id.name"/></td><td class="queue-state" t-out="entry.state"/><td class="queue-missed" t-out="entry.ydental_missed_count"/>
                        <td><t t-if="entry.ydental_return and not entry.ydental_opportunity_used">Unused return opportunity</t><t t-else="">Regular order</t></td>
                        <td><span t-out="row['reason']"/><t t-if="can_write and own and entry.state == 'calling' and entry.ydental_lease_id == own">
                            <button type="button" data-operation="missed" t-att-data-entry="entry.id">Record real missed call</button>
                            <button type="button" data-operation="start" t-att-data-entry="entry.id">Start actual execution</button>
                        </t></td>
                    </tr></tbody>
                </table>
                <p>Production heartbeat, timeout and missed displacement require explicit approval. Real treatment documents and dispensing are not enabled. Queue changes are committed before minimal version notifications.</p>
            </main>
        </t>
    </template>
    <template id="ydental_queue_screen" name="Read-only area queue screen">
        <t t-set="head"><meta name="viewport" content="width=device-width, initial-scale=1"/><script type="module" src="/ydental_queue/static/src/screen/screen.js"/></t>
        <t t-call="web.layout" head="head"><main class="container py-4 o_ydental_queue_screen">
            <h1>Area queue screen</h1><p><span data-day=""/> / <span data-business=""/></p>
            <span hidden="hidden" data-label-open="">Open</span><span hidden="hidden" data-label-draining="">Ordinary reporting stopped</span><span hidden="hidden" data-label-closed="">Ordinary calling stopped</span>
            <span hidden="hidden" data-unavailable="">Screen unavailable or credential revoked. No call is confirmed.</span>
            <p role="status" data-status=""/><label><input type="checkbox" data-voice=""/> Enable call voice</label>
            <table class="table"><thead><tr><th>Queue number</th><th>Masked name</th><th>Current state</th><th>Actual calling workstation</th></tr></thead><tbody/></table>
        </main></t>
    </template>
</odoo>
