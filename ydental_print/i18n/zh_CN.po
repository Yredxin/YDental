#. module: ydental_print
#: model_terms:ir.ui.view,arch_db:ydental_print.ydental_print_page
msgid ""
"<span data-message=\"busy\">Processing the selected source. Keep this page open.</span>\n"
"                <span data-message=\"reviewed\">Source reviewed. Generate the selected demonstration PDF.</span>\n"
"                <span data-message=\"generated\">PDF generated. Physical paper output is unknown.</span>\n"
"                <span data-message=\"viewed\">PDF view request succeeded. Physical paper output is unknown.</span>\n"
"                <span data-message=\"downloaded\">Download request succeeded. Physical paper output is unknown.</span>\n"
"                <span data-message=\"print_requested\">Print request recorded. In the opened PDF viewer, use its print button or the browser print dialog. Physical paper output is unknown.</span>\n"
"                <span data-message=\"failed\">Unconfirmed or failed response. Refresh and review the source before retrying. No automatic replay; physical paper output is unknown.</span>\n"
"                <span data-message=\"dialog_failed\">Print request recorded, but the PDF viewer could not be opened. Allow popups and request again. Physical paper output is unknown.</span>"
msgstr ""
"<span data-message=\"busy\">正在处理所选来源。请保持本页打开。</span>\n"
"                <span data-message=\"reviewed\">已核对来源。可生成所选演示 PDF。</span>\n"
"                <span data-message=\"generated\">PDF 已生成。打印机实际出纸状态未知。</span>\n"
"                <span data-message=\"viewed\">PDF 查看请求成功。打印机实际出纸状态未知。</span>\n"
"                <span data-message=\"downloaded\">下载请求成功。打印机实际出纸状态未知。</span>\n"
"                <span data-message=\"print_requested\">已记录打印请求。请在打开的 PDF 查看器使用打印按钮或浏览器打印对话框。打印机实际出纸状态未知。</span>\n"
"                <span data-message=\"failed\">响应未确认或失败。重试前请刷新并核对来源。不自动重放；打印机实际出纸状态未知。</span>\n"
"                <span data-message=\"dialog_failed\">已记录打印请求，但未能打开 PDF 查看器。请允许弹出窗口后重新请求。打印机实际出纸状态未知。</span>"

