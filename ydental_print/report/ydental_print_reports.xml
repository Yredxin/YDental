<odoo>
    <record id="ydental_pdf_a4" model="report.paperformat">
        <field name="name">YDental demonstration A4</field>
        <field name="format">A4</field><field name="orientation">Portrait</field>
        <field name="margin_top">12</field><field name="margin_bottom">16</field>
        <field name="margin_left">14</field><field name="margin_right">14</field>
        <field name="dpi">96</field><field name="disable_shrinking">True</field>
    </record>
    <record id="ydental_pdf_report" model="ir.actions.report">
        <field name="name">Controlled YDental demonstration PDF</field>
        <field name="model">ydental.print.job</field>
        <field name="report_type">qweb-pdf-wkhtmltopdf</field>
        <field name="report_name">ydental_print.ydental_document_pdf</field>
        <field name="paperformat_id" ref="ydental_pdf_a4"/>
        <field name="group_ids" eval="[(4, ref('ydental_base.ydental_base_group_user'))]"/>
    </record>
    <record id="ydental_pdf_80mm" model="report.paperformat">
        <field name="name">YDental 80 mm demonstration without device approval</field>
        <field name="format">custom</field><field name="page_width">80</field><field name="page_height">297</field>
        <field name="orientation">Portrait</field><field name="margin_top">6</field><field name="margin_bottom">10</field>
        <field name="margin_left">4</field><field name="margin_right">4</field><field name="dpi">96</field><field name="disable_shrinking">True</field>
    </record>
    <record id="ydental_pdf_label100x70" model="report.paperformat">
        <field name="name">YDental 100 x 70 mm demonstration label</field>
        <field name="format">custom</field><field name="page_width">100</field><field name="page_height">70</field>
        <field name="orientation">Portrait</field><field name="margin_top">3</field><field name="margin_bottom">3</field>
        <field name="margin_left">3</field><field name="margin_right">3</field>
        <field name="dpi">96</field><field name="disable_shrinking">True</field>
    </record>
</odoo>
