<odoo>
    <template id="ydental_pdf_layout" name="Inline PDF layout">
        <html><head><meta charset="utf-8"/></head><body><t t-out="body"/></body></html>
    </template>
    <template id="ydental_document_pdf" name="Controlled demonstration PDF">
        <html><head><meta charset="utf-8"/></head><body><main t-att-class="'o_ydental_print_consent' if p['kind'] == 'consent' else ''"><style>
            body {margin: 0; font-family: 'Noto Sans CJK SC', sans-serif; font-size: 9.5pt; line-height: 1.35; color: #18252e;}
            h1 {font-size: 17pt; margin: 0 0 5px; page-break-after: avoid;} h2 {font-size: 11pt; margin: 10px 0 4px; page-break-after: avoid;}
            p {margin: 3px 0; white-space: pre-wrap; word-wrap: break-word; word-break: break-all; orphans: 3; widows: 3;}
            .o_ydental_print_consent p {margin-top: 2px; margin-bottom: 2px;}
            .o_ydental_print_consent h2 {margin-top: 8px;}
            table.o_ydental_print_consent_tail {font-size: 9.5pt; border: 0; margin: 0; page-break-inside: avoid;}
            .o_ydental_print_consent_tail td {font-size: 9.5pt; border: 0; padding: 0; page-break-inside: avoid;}
            .warning {border-left: 3px solid #9a3b27; padding: 4px 7px; font-weight: bold; color: #8b2e18; margin-bottom: 6px;}
            table {width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 9pt;}
            td, th {padding: 4px; border: 1px solid #bdc5cb; vertical-align: top; word-wrap: break-word; word-break: break-all;}
            th {background: #e8edf0;} tr {page-break-inside: avoid;} thead {display: table-header-group;}
            .label {width: 34%;} .meta {font-size: 8pt; color: #394e60;} .blank {height: 22px; border-bottom: 1px solid #c6cbd0;}
            .o_ydental_print_trace {border-top: 1px solid #bdc5cb; padding-top: 4px; margin-top: 8px;}
            .o_ydental_print_trace p {margin: 1px 0;}
            .o_ydental_print_flow {white-space: normal; word-wrap: break-word; word-break: break-all; orphans: 2; widows: 2;}
            .o_ydental_print_field {display: inline; margin-right: 8px;}
            .o_ydental_print_business {margin: 5px 0; font-size: 9.5pt;}
            .o_ydental_print_rx_line {border-bottom: 1px solid #bdc5cb; padding-bottom: 6px; page-break-inside: auto;}
            .o_ydental_print_rx_intro {page-break-inside: avoid;}
            .o_ydental_print_rx_intro h2 {page-break-after: auto;}
            .o_ydental_print_rx_field {margin: 4px 0; page-break-inside: auto;}
            .o_ydental_print_rx_field strong {display: block; background: #e8edf0; padding: 3px 5px; page-break-after: avoid;}
            .o_ydental_print_rx_field p {margin: 2px 5px; page-break-inside: auto;}
            .o_ydental_print_section_intro {page-break-inside: avoid;}
            table.o_ydental_print_section_intro {font-size: 9.5pt; border: 0; margin: 0;}
            .o_ydental_print_section_intro td {font-size: 9.5pt; border: 0; padding: 0;}
            .o_ydental_print_source_intro {page-break-after: avoid;}
            .o_ydental_print_label {font-size: 9pt; line-height: 1.2;}
            .o_ydental_print_label h1 {font-size: 11pt; margin-bottom: 2px;}
            .o_ydental_print_label h1 span {font-size: 9pt; font-weight: normal;}
            .o_ydental_print_label p {margin: 1px 0; orphans: 2; widows: 2;}
            .o_ydental_print_label_qr {float: right; width: 28mm; margin: 0 0 1mm 2mm;}
            .o_ydental_print_label_qr img {width: 28mm; height: 28mm;}
            .o_ydental_print_label_identity {font-weight: bold;}
            .o_ydental_print_finance_identity {margin-bottom: 5px;}
            .o_ydental_print_finance_identity span {display: inline-block; margin-right: 10px;}
        </style>
            <t t-set="financial" t-value="p.get('financial')"/>
            <t t-if="p['kind'] == 'lab_label'">
                <article class="o_ydental_print_label">
                    <h1><strong>Laboratory label</strong> <span t-if="p.get('synthetic') and p.get('template_state') != 'synthetic_unreviewed'">Synthetic demonstration</span> <span t-out="p.get('template_state_label', '')"/></h1>
                    <div class="o_ydental_print_label_qr"><img t-att-src="'data:image/png;base64,' + p['barcode']['png']" alt="Internal package identification QR code"/></div>
                    <p class="o_ydental_print_label_identity"><span>Work order:</span> <t t-out="p['source_id']"/> / <span>Cycle:</span> <t t-out="p['versions']['cycle']"/></p>
                    <p><strong>Store:</strong> <t t-out="p['label_business']['store']"/></p>
                    <p><strong>Patient number:</strong> <t t-out="p['label_business']['patient_number']"/></p>
                    <p><strong>Snapshot state:</strong> <t t-out="p['label_business']['state']"/></p>
                    <p><strong>Teeth:</strong> <t t-out="p['label_business']['teeth']"/> / <strong>Quantity:</strong> <t t-out="p['label_business']['quantity']"/></p>
                    <p><strong>Material / shade:</strong> <t t-out="p['label_business']['material']"/> / <t t-out="p['label_business']['shade']"/></p>
                    <p style="clear: both"><strong>Processing:</strong> <t t-out="p['label_business']['instructions']"/></p>
                    <p style="clear: both"><strong>Identification code:</strong> <t t-out="p['barcode']['value']"/></p>
                    <p>Identify only; no receipt, put-away or notice. No shipment or receipt is implied.</p>
                    <p><span>Generated UTC:</span> <t t-out="p['generated_at']"/> / <span>Source v</span><t t-out="p['version']"/> / UX7</p>
                    <p t-foreach="p.get('template_paragraphs', [])" t-as="paragraph" t-out="paragraph"/>
                    <p><span>Authorized trace:</span> /ydental/documents</p>
                </article>
            </t>
            <t t-else="">
            <h1 t-out="p['title']"/>
            <div class="warning"><span t-if="not p.get('original')">DEMONSTRATION / UNREVIEWED / NO FORMAL SIGNATURE</span><span t-if="p.get('original') and p.get('synthetic') and not financial">SYNTHETIC TEST / NOT A FORMAL CLINICAL DOCUMENT / 合成测试，非正式临床文件</span><span t-if="p.get('original') and p.get('synthetic') and financial">SYNTHETIC OFFLINE BUSINESS DOCUMENT / NOT A TAX INVOICE</span><span t-if="p.get('original') and not p.get('synthetic')">PUBLISHED CONTENT / SIGNATURE AND PHYSICAL OUTPUT ARE SEPARATE FACTS</span><br/><t t-out="financial['state'] if financial else p['status']"/></div>
            <p t-if="not financial">Only the explicitly selected source set is included. This is not a complete formal medical record unless the scope and confirmation checks explicitly identify a complete source set.</p>
            <p t-out="p['selected_state']"/>
            <div t-if="financial">
                <p class="o_ydental_print_finance_identity"><span t-foreach="p.get('business_identity', p['identity'])" t-as="row"><strong t-out="row[0]"/>: <t t-out="row[1]"/></span></p>
                <p><strong>Document number:</strong> <t t-out="financial['number']"/></p>
                <table><tbody><tr t-foreach="financial['totals']" t-as="row"><th class="label" t-out="row[0]"/><td t-out="row[1]"/></tr></tbody></table>
                <h2 t-if="financial['rows']">Confirmed sources and allocations</h2>
                <table t-if="financial['rows']"><thead><tr><th>Bill or confirmed item</th><th t-if="p['kind'] == 'bill'">Frozen price version</th><th t-if="p['kind'] == 'bill'">Confirmed amount</th><th t-if="p['kind'] != 'bill'">Bill total / allocated / receivable</th></tr></thead><tbody>
                    <tr t-foreach="financial['rows']" t-as="row"><td t-out="row['number']"/><td t-if="p['kind'] == 'bill'" t-out="row['price_version']"/><td t-if="p['kind'] == 'bill'" t-out="row['amount']"/><td t-if="p['kind'] != 'bill'"><t t-out="row['bill_total']"/> / <t t-out="row['allocated']"/> / <t t-out="row['residual']"/></td></tr>
                </tbody></table>
                <p t-foreach="financial['times']" t-as="row"><strong t-out="row[0]"/>: <t t-out="row[1]"/></p>
                <p t-if="financial.get('channel')"><strong>Recorded channel:</strong> <t t-out="financial['channel']"/></p>
                <p t-if="financial.get('reason')"><strong>Refund reason:</strong> <t t-out="financial['reason']"/></p>
            </div>
            <section t-if="financial and p.get('template_paragraphs')"><h2>Reviewed template content</h2><p t-foreach="p['template_paragraphs']" t-as="paragraph" t-out="paragraph"/></section>
            <p t-if="not financial" class="o_ydental_print_flow o_ydental_print_business"><span t-foreach="p.get('business_identity', p['identity']) + p.get('business_details', p['details'])" t-as="row" class="o_ydental_print_field"><strong t-out="row[0]"/>: <t t-out="row[1]"/>;</span></p>
            <section t-if="not financial" t-foreach="p['sections']" t-as="section">
                <t t-set="source_intro" t-value="p['kind'] == 'clinical_summary' and section['paragraphs'] and section['paragraphs'][0] == p['status']"/>
                <t t-set="intro_count" t-value="len(section['paragraphs']) if source_intro else ([index + 1 for index, paragraph in enumerate(section['paragraphs']) if paragraph.strip()] or [len(section['paragraphs'])])[0]"/>
                <t t-set="consent_tail" t-value="p['kind'] == 'consent' and section_last"/>
                <t t-set="tail_index" t-value="([index for index, paragraph in enumerate(section['paragraphs']) if paragraph.strip()] or [0])[-1]"/>
                <t t-set="short_tail" t-value="consent_tail and (not section['paragraphs'] or tail_index &lt; intro_count)"/>
                <table t-if="not short_tail" t-att-class="'o_ydental_print_section_intro o_ydental_print_source_intro' if source_intro else 'o_ydental_print_section_intro'"><tbody><tr><td>
                    <h2 t-out="section['label']"/>
                    <p t-if="source_intro" class="o_ydental_print_flow"><span t-foreach="section['paragraphs']" t-as="paragraph" class="o_ydental_print_field"><t t-out="paragraph"/>;</span></p>
                    <t t-else=""><p t-foreach="section['paragraphs'][:intro_count]" t-as="paragraph" t-out="paragraph"/></t>
                    <div t-if="p['kind'] == 'consent' and len(section['paragraphs']) &lt;= intro_count" class="blank"/>
                </td></tr></tbody></table>
                <t t-if="consent_tail">
                    <p t-if="not short_tail" t-foreach="section['paragraphs'][intro_count:tail_index]" t-as="paragraph" t-out="paragraph"/>
                    <table class="o_ydental_print_consent_tail"><tbody><tr><td>
                        <h2 t-if="short_tail" t-out="section['label']"/>
                        <p t-foreach="section['paragraphs'] if short_tail else section['paragraphs'][tail_index:]" t-as="paragraph" t-out="paragraph"/>
                        <div class="blank"/>
                        <t t-call="ydental_print.ydental_document_trace"/>
                    </td></tr></tbody></table>
                </t>
                <t t-else="">
                    <p t-foreach="section['paragraphs'][intro_count:]" t-as="paragraph" t-out="paragraph"/>
                    <div t-if="p['kind'] == 'consent' and len(section['paragraphs']) &gt; intro_count" class="blank"/>
                </t>
            </section>
            <t t-if="p['kind'] == 'clinical'">
                <h2>Recorded FDI teeth and surfaces</h2>
                <p>Unlisted teeth have no recorded conclusion. 0 means no corresponding tooth.</p>
                <table><thead><tr><th>FDI tooth</th><th>Recorded state</th><th>Recorded surfaces</th></tr></thead><tbody><tr t-foreach="p['teeth']" t-as="tooth"><td t-out="tooth['tooth']"/><td t-out="tooth['state']"/><td t-out="tooth['surfaces']"/></tr></tbody></table>
                <p t-if="not p['teeth']">No tooth findings recorded.</p>
            </t>
            <t t-if="p['kind'] == 'prescription'">
                <h2>Actual prescribed medicine lines</h2>
                <article t-foreach="p['lines']" t-as="line" class="o_ydental_print_rx_line">
                    <div class="o_ydental_print_rx_intro">
                        <h2><span>Line ID:</span> <t t-out="line['id']"/></h2>
                        <div class="o_ydental_print_rx_field"><strong>SKU / medicine / specification</strong><p t-out="line['sku']"/><p t-out="line['name']"/><p t-out="line['product_specification']"/><p t-out="line['specification']"/></div>
                    </div>
                    <div class="o_ydental_print_rx_field"><strong>Usage / frequency / course</strong><p t-out="line['usage']"/><p t-out="line['frequency']"/><p t-out="line['course']"/></div>
                    <div class="o_ydental_print_rx_field"><strong>Approved / actually dispensed / uncollected</strong><p><span>Approved:</span> <t t-out="line['approved']"/></p><p><span>Actually dispensed:</span> <t t-out="line['dispensed']"/></p><p><span>Uncollected:</span> <t t-out="line['remaining']"/></p><p t-out="line['unit']"/></div>
                    <div class="o_ydental_print_rx_field"><strong>State / reason</strong><p t-out="line['state']"/><p t-out="line['reason']"/></div>
                </article>
                <h2>Actual dispensing facts (not payment)</h2>
                <table><thead><tr><th>Event / line / SKU</th><th>Actual quantity / operator</th><th>UTC / store business date</th><th>Reconciliation / price source ID</th></tr></thead><tbody>
                    <tr t-foreach="p['events']" t-as="event"><td><t t-out="event['id']"/> / <t t-out="event['line_id']"/> / <t t-out="event['product_id']"/></td><td><t t-out="event['quantity']"/> / <t t-out="event['actor']"/></td><td><t t-out="event['time']"/><br/><t t-out="event['business_date']"/></td><td><t t-out="event['state']"/> / <t t-out="event['price_source']"/> / <t t-out="event['medicine_link']"/></td></tr>
                </tbody></table><p t-if="not p['events']">No actual dispensing has been recorded.</p>
            </t>
            <t t-if="p['kind'] != 'consent' or not p['sections']" t-call="ydental_print.ydental_document_trace"/>
            </t>
        </main></body></html>
    </template>
    <template id="ydental_document_trace" name="Document source and version trace">
            <div class="o_ydental_print_trace meta">
                <p class="o_ydental_print_flow">
                    <span t-if="p.get('original')" class="o_ydental_print_field"><strong>Content template / version / review state:</strong> <t t-out="p['content_template']"/> / <t t-out="p['content_template_version']"/> / <t t-out="p.get('template_state_label', p['template_state'])"/>; <span>Applicable scope:</span> <t t-out="p['applicability']"/>;</span>
                    <span class="o_ydental_print_field"><strong>Source ID / selected version:</strong> <t t-out="p['source_id']"/> / <t t-out="p['version']"/>; <span>Layout:</span> <t t-out="p.get('layout_version', p['template'])"/>;</span>
                    <span class="o_ydental_print_field"><span>Generated by:</span> <t t-out="p['generated_by']"/>; <span>Generation and extraction time (UTC):</span> <t t-out="p['generated_at']"/>;</span>
                    <span class="o_ydental_print_field"><span>Normalized source SHA256:</span> <t t-out="p['source_digest']"/>;</span>
                    <span t-foreach="p.get('version_summary', [])" t-as="reference" class="o_ydental_print_field"><strong t-out="reference['label']"/>: <t t-out="reference['value']"/>;</span>
                    <t t-if="not financial"><span t-foreach="p.get('technical_details', [])" t-as="row" class="o_ydental_print_field"><strong t-out="row[0]"/>: <t t-out="row[1]"/>;</span></t>
                </p>
                <p t-if="not p.get('original')"><span>Source version set:</span> <t t-out="p['versions']"/></p>
                <p t-if="not p.get('original')">No signature or physical paper output is verified. Temporary demonstration copy; formal archival and original reprinting are not provided.</p>
                <p t-if="p.get('original')">Immutable original; reprinting reads stored bytes. Generation and print requests do not prove signature or physical paper output.</p>
            </div>
    </template>
</odoo>
