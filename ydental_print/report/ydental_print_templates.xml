<odoo>
    <template id="ydental_pdf_layout" name="Inline PDF layout">
        <html><head><meta charset="utf-8"/></head><body><t t-out="body"/></body></html>
    </template>
    <template id="ydental_document_pdf" name="Controlled demonstration PDF">
        <html><head><meta charset="utf-8"/></head><body><main><style>
            body {margin: 0; font-family: 'Noto Sans CJK SC', sans-serif; font-size: 9.5pt; line-height: 1.5; color: #18252e;}
            h1 {font-size: 19pt; margin: 0 0 8px;} h2 {font-size: 12pt; margin: 14px 0 4px; page-break-after: avoid;}
            p {margin: 4px 0; white-space: pre-wrap; word-wrap: break-word; word-break: break-all;}
            .warning {border: 2px solid #9a3b27; padding: 8px; font-weight: bold; color: #8b2e18;}
            table {width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 9pt;}
            td, th {padding: 5px; border: 1px solid #bdc5cb; vertical-align: top; word-wrap: break-word; word-break: break-all;}
            th {background: #e8edf0;} tr {page-break-inside: avoid;} thead {display: table-header-group;}
            p:last-child {margin-bottom: 0;} .provenance {page-break-inside: avoid;} p {page-break-inside: avoid;} .label {width: 30%;} .meta {font-size: 8pt; color: #394e60;} .blank {min-height: 35px; border-bottom: 1px solid #c6cbd0;}
            .o_ydental_print_rx_line {border-bottom: 1px solid #bdc5cb; padding-bottom: 8px; page-break-inside: auto;}
            .o_ydental_print_rx_intro {page-break-inside: avoid;}
            .o_ydental_print_rx_intro h2 {page-break-after: auto;}
            .o_ydental_print_rx_field {margin: 5px 0; page-break-inside: auto;}
            .o_ydental_print_rx_field strong {display: block; background: #e8edf0; padding: 3px 5px; page-break-after: avoid;}
            .o_ydental_print_rx_field p {margin: 2px 5px; page-break-inside: auto;}
            .o_ydental_print_section_intro {page-break-inside: avoid;}
        </style>
            <h1 t-out="p['title']"/>
            <div class="warning"><span t-if="not p.get('original')">DEMONSTRATION / UNREVIEWED / NO FORMAL SIGNATURE</span><span t-if="p.get('original') and p.get('synthetic')">SYNTHETIC TEST / NOT A FORMAL CLINICAL DOCUMENT / 合成测试，非正式临床文件</span><span t-if="p.get('original') and not p.get('synthetic')">PUBLISHED CONTENT / SIGNATURE AND PHYSICAL OUTPUT ARE SEPARATE FACTS</span><br/><t t-out="p['status']"/></div>
            <p>Only the explicitly selected source set is included. This is not a complete formal medical record unless the scope and confirmation checks explicitly identify a complete source set.</p>
            <p t-if="p.get('original')"><span>Content template / version / review state:</span> <t t-out="p['content_template']"/> / <t t-out="p['content_template_version']"/> / <t t-out="p['template_state']"/><br/><span>Applicable scope:</span> <t t-out="p['applicability']"/></p>
            <p t-out="p['selected_state']"/>
            <div t-if="p['kind'] == 'lab_label'" class="o_ydental_print_section_intro">
                <img t-att-src="'data:image/png;base64,' + p['barcode']['png']" width="180" height="180" alt="Internal package identification QR code"/>
                <p t-out="p['barcode']['value']"/>
                <p>Identification only. Scanning this code does not authorize patient access, receive goods or put away stock.</p>
            </div>
            <table><tbody><tr t-foreach="p['identity'] + p['details']" t-as="row"><td class="label" t-out="row[0]"/><td t-out="row[1]"/></tr></tbody></table>
            <section t-foreach="p['sections']" t-as="section">
                <div class="o_ydental_print_section_intro"><h2 t-out="section['label']"/><p t-if="section['paragraphs']" t-out="section['paragraphs'][0]"/></div>
                <p t-foreach="section['paragraphs'][1:]" t-as="paragraph" t-out="paragraph"/>
                <div t-if="p['kind'] == 'consent'" class="blank"/>
            </section>
            <t t-if="p['kind'] == 'clinical'">
                <h2>Recorded FDI teeth and surfaces</h2>
                <p>Unlisted teeth have no recorded conclusion. 0 means no corresponding tooth.</p>
                <table><thead><tr><th>FDI tooth</th><th>Recorded state</th><th>Recorded surfaces</th></tr></thead><tbody><tr t-foreach="p['teeth']" t-as="tooth"><td t-out="tooth['tooth']"/><td t-out="tooth['state']"/><td t-out="tooth['surfaces']"/></tr></tbody></table>
                <p t-if="not p['teeth']">No tooth findings recorded.</p>
            </t>
            <t t-if="p['kind'] == 'prescription'">
                <h2>Actual prescribed medicine lines</h2>
                <article t-foreach="p['lines']" t-as="line" class="o_ydental_print_rx_line">
                    <div class="o_ydental_print_rx_intro">
                        <h2><span>Line ID:</span> <t t-out="line['id']"/></h2>
                        <div class="o_ydental_print_rx_field"><strong>SKU / medicine / specification</strong><p t-out="line['sku']"/><p t-out="line['name']"/><p t-out="line['product_specification']"/><p t-out="line['specification']"/></div>
                    </div>
                    <div class="o_ydental_print_rx_field"><strong>Usage / frequency / course</strong><p t-out="line['usage']"/><p t-out="line['frequency']"/><p t-out="line['course']"/></div>
                    <div class="o_ydental_print_rx_field"><strong>Approved / actually dispensed / uncollected</strong><p><span>Approved:</span> <t t-out="line['approved']"/></p><p><span>Actually dispensed:</span> <t t-out="line['dispensed']"/></p><p><span>Uncollected:</span> <t t-out="line['remaining']"/></p><p t-out="line['unit']"/></div>
                    <div class="o_ydental_print_rx_field"><strong>State / reason</strong><p t-out="line['state']"/><p t-out="line['reason']"/></div>
                </article>
                <h2>Actual dispensing facts (not payment)</h2>
                <table><thead><tr><th>Event / line / SKU</th><th>Actual quantity / operator</th><th>UTC / store business date</th><th>Reconciliation / price source ID</th></tr></thead><tbody>
                    <tr t-foreach="p['events']" t-as="event"><td><t t-out="event['id']"/> / <t t-out="event['line_id']"/> / <t t-out="event['product_id']"/></td><td><t t-out="event['quantity']"/> / <t t-out="event['actor']"/></td><td><t t-out="event['time']"/><br/><t t-out="event['business_date']"/></td><td><t t-out="event['state']"/> / <t t-out="event['price_source']"/> / <t t-out="event['medicine_link']"/></td></tr>
                </tbody></table><p t-if="not p['events']">No actual dispensing has been recorded.</p>
            </t>
            <t t-if="p.get('original')"><div class="o_ydental_print_section_intro"><h2>Source and selected version references</h2>
                <p class="meta">The full source, accounting and template snapshots are retained with this immutable original for authorized review.</p></div>
                <table><thead><tr><th>Source</th><th>Selected version / frozen reference</th></tr></thead><tbody>
                    <tr t-foreach="p['version_summary']" t-as="reference"><td t-out="reference['label']"/><td t-out="reference['value']"/></tr>
                </tbody></table>
            </t>
            <div class="provenance"><h2>Document provenance</h2>
            <p class="meta"><span>Template:</span> <t t-out="p['template']"/> / <span>Source ID / selected version:</span> <t t-out="p['source_id']"/> / <t t-out="p['version']"/></p>
            <p class="meta"><span>Generated by:</span> <t t-out="p['generated_by']"/> / <span>Generation and extraction time (UTC):</span> <t t-out="p['generated_at']"/></p>
            <p class="meta"><span>Normalized source SHA256:</span> <t t-out="p['source_digest']"/></p>
            <p t-if="not p.get('original')" class="meta"><span>Source version set:</span> <t t-out="p['versions']"/></p>
            <p t-if="not p.get('original')">No signature or physical paper output is verified. Temporary demonstration copy; formal archival and original reprinting are not provided.</p>
            <p t-if="p.get('original')">This file is preserved as an immutable original. Reprinting reads its stored bytes. No signature or physical paper output is inferred from generation or a print request.</p></div>
        </main></body></html>
    </template>
</odoo>
