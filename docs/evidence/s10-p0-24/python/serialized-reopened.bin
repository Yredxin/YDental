  "arch_prev_text": "<?xml version=\"1.0\"?>\n<t name=\"My journal email notification settings\" t-name=\"account.portal_my_journal_mail_notifications\">\n        <t t-call=\"portal.portal_layout\" breadcrumbs_searchbar=\"True\">\n            <t t-call=\"portal.portal_searchbar\" breadcrumbs_searchbar=\"True\" title.translate=\"Email Notifications\"/>\n            <div class=\"row\">\n                <div class=\"col-12\">\n                    <div class=\"card\">\n                        <div class=\"card-body\">\n                            <h5 class=\"card-title\">Invoice Notifications</h5>\n                            <p class=\"card-text\">You can unsubscribe from emails received upon invoice sending and reception here.</p>\n                            <t t-if=\"completed\">\n                                <div class=\"alert alert-success\" role=\"alert\">\n                                    Successfully unsubscribed <t t-if=\"email\"><strong t-out=\"email\"/></t> from invoice notifications.\n                                </div>\n                            </t>\n                            <t t-elif=\"error\">\n                                <div class=\"alert alert-danger\" role=\"alert\">\n                                    <t t-out=\"error\"/>\n                                </div>\n                            </t>\n                            <t t-else=\"\">\n                                <div t-if=\"email\" class=\"alert alert-info\" role=\"alert\">\n                                    You are about to unsubscribe <strong t-out=\"email\"/> from invoice notifications.\n                                </div>\n                                <form method=\"POST\">\n                                    <input type=\"hidden\" name=\"csrf_token\" t-att-value=\"request.csrf_token()\"/>\n                                    <button type=\"submit\" class=\"btn btn-primary\">Unsubscribe</button>\n                                </form>\n                            </t>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </t>\n    </t>\n\n    ",
