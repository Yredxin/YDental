<odoo>
    <template id="ydental_supply_tokens">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="revision" t-att-value="revision"/>
        <input type="hidden" name="key" t-att-value="new_key()"/>
    </template>
    <template id="ydental_supply_location">
        <label>Workstation</label><select name="station_id" class="form-select"><option value="">Choose workstation or area</option><t t-foreach="stations" t-as="station"><option t-att-value="station.id"><t t-out="station.name"/></option></t></select>
        <label>Area</label><select name="area_id" class="form-select"><option value="">Choose area or workstation</option><t t-foreach="areas" t-as="area"><option t-att-value="area.id"><t t-out="area.name"/></option></t></select>
    </template>
    <template id="ydental_supply_staff">
        <label>Employee</label><select name="user_id" class="form-select" required="required"><t t-foreach="members" t-as="member"><option t-att-value="member.ydental_user_id.id"><t t-out="member.ydental_user_id.name"/></option></t></select>
    </template>
    <template id="ydental_supply_reason"><label>Reason</label><input name="reason" class="form-control" required="required" maxlength="300"/></template>
    <template id="ydental_supply_times">
        <label>Start (store local time)</label><input type="datetime-local" name="start" class="form-control" required="required"/>
        <label>End (store local time)</label><input type="datetime-local" name="end" class="form-control" required="required"/>
    </template>
    <template id="ydental_supply_page" name="Schedule and capacity">
        <t t-call="web.layout"><t t-set="title">Schedule and capacity</t>
            <main class="container py-4 o_ydental_supply_workspace">
                <nav class="mb-3"><a href="/odoo">YDental</a> / <a href="/ydental/access">Store and access</a> / <a href="/ydental/supply/today">My today</a></nav>
                <h1>Schedule and capacity</h1><p class="lead"><t t-out="store.name"/> · <t t-out="store.ydental_timezone"/></p>
                <p>Personnel arrangements suggest a location. Capacity belongs to workstation time slots.</p>
                <div class="alert alert-info" t-if="not can_write">Read only</div>
                <section class="card p-3 mb-4" id="weekly-plan">
                    <h2>Weekly plan</h2>
                    <nav class="d-flex gap-3 mb-3"><a t-att-href="'/ydental/supply?week_start=%s&amp;group_by=%s' % (previous_week, group_by)">Previous week</a><strong t-out="week"/><a t-att-href="'/ydental/supply?week_start=%s&amp;group_by=%s' % (next_week, group_by)">Next week</a><a t-att-href="'/ydental/supply?week_start=%s&amp;group_by=station' % week">By workstation</a><a t-att-href="'/ydental/supply?week_start=%s&amp;group_by=person' % week">By employee</a></nav>
                    <t t-foreach="groups.items()" t-as="group"><h3 t-out="group[0].display_name or 'Area assignments'"/>
                    <table class="table"><thead><tr><th>Employee</th><th>Location</th><th>Time</th><th>Status</th><th>Actions</th></tr></thead><tbody>
                    <tr t-foreach="group[1]" t-as="assignment"><td t-out="assignment.name"/><td t-out="assignment.ydental_station_id.name or assignment.ydental_area_id.name"/><td><t t-out="format_time(assignment.ydental_start)"/> - <t t-out="format_time(assignment.ydental_end)"/></td><td><span t-out="assignment.state"/><p class="text-warning" t-out="assignment.ydental_warning"/><p t-if="assignment.ydental_warning">Replacement candidates: <t t-foreach="replacement_candidates(assignment)" t-as="candidate"><span class="me-2" t-out="candidate.name"/></t></p></td><td t-if="can_write">
                        <details><summary>Adjust</summary><form method="post" action="/ydental/supply/action"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="adjust"/><input type="hidden" name="id" t-att-value="assignment.id"/><input type="hidden" name="version" t-att-value="assignment.ydental_version"/><t t-call="ydental_supply.ydental_supply_staff"/><t t-call="ydental_supply.ydental_supply_location"/><t t-call="ydental_supply.ydental_supply_times"/><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-primary">Save adjustment</button></form></details>
                        <details><summary>Cancel arrangement</summary><form method="post" action="/ydental/supply/action"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="cancel_assignment"/><input type="hidden" name="id" t-att-value="assignment.id"/><input type="hidden" name="version" t-att-value="assignment.ydental_version"/><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-outline-danger">Cancel arrangement</button></form></details>
                    </td></tr></tbody></table></t>
                    <t t-if="can_write">
                        <details class="mb-2"><summary>New arrangement</summary><form method="post" action="/ydental/supply/action" class="p-3"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="assign"/><t t-call="ydental_supply.ydental_supply_staff"/><t t-call="ydental_supply.ydental_supply_location"/><t t-call="ydental_supply.ydental_supply_times"/><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-primary mt-2">Save arrangement</button></form></details>
                        <details class="mb-2"><summary>Batch template</summary><form method="post" action="/ydental/supply/action" class="p-3"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="batch"/><t t-call="ydental_supply.ydental_supply_staff"/><t t-call="ydental_supply.ydental_supply_location"/><label>Dates, separated by commas (YYYY-MM-DD)</label><input name="dates" required="required" class="form-control"/><label>Start time</label><input type="time" name="start_time" required="required"/><label>End time</label><input type="time" name="end_time" required="required"/><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-primary mt-2">Save batch</button></form></details>
                        <form method="post" action="/ydental/supply/action"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="copy"/><input type="hidden" name="week_start" t-att-value="week"/><button class="btn btn-outline-primary">Copy previous week</button></form>
                    </t>
                </section>
                <section class="card p-3 mb-4" id="capacity-policy"><h2>Capacity policy</h2><p>Default reservation to walk-in ratio: 1:2. Precedence: workstation, nearest area, store. Existing slots retain their policy version.</p>
                    <table class="table"><thead><tr><th>Version</th><th>Scope</th><th>Ratio</th><th>Rounding</th><th>Telephone pool</th><th>Cutoff minutes before start</th></tr></thead><tbody><tr t-foreach="policies" t-as="policy"><td><t t-out="policy.name"/> (<t t-out="policy.ydental_mode"/>)</td><td t-out="policy.ydental_station_id.name or policy.ydental_area_id.name or store.name"/><td><t t-out="policy.ydental_reservation_weight"/>:<t t-out="policy.ydental_walkin_weight"/></td><td t-out="policy.ydental_rounding"/><td t-out="policy.ydental_phone_pool"/><td t-out="policy.ydental_cutoff_minutes"/></tr></tbody></table>
                    <details t-if="can_write"><summary>New policy version and integer preview</summary><form method="post" action="/ydental/supply/action" class="p-3"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="policy"/><label>Name</label><input name="name" required="required" class="form-control"/><t t-call="ydental_supply.ydental_supply_location"/><label>Reservation weight</label><input type="number" name="reservation_weight" value="1" min="1" max="100"/><label>Walk-in weight</label><input type="number" name="walkin_weight" value="2" min="1" max="100"/><label>Rounding</label><select name="rounding"><option value="floor">Round reservation down</option><option value="nearest">Round reservation to nearest</option></select><label>Telephone pool</label><select name="phone_pool"><option value="reservation">Reservation</option><option value="walkin">Walk-in</option></select><label>Cutoff minutes before start</label><input type="number" name="cutoff_minutes" min="0" max="1440" value="0"/><label>Publication</label><select name="mode"><option value="demo">Demonstration</option><option value="published">Approved publication</option></select><label><input type="checkbox" name="approved" value="yes"/> I confirm formal production policy approval</label><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-primary mt-2" name="output" value="json">Save and preview Q=1,2,3,6</button></form></details>
                </section>
                <section class="card p-3 mb-4" id="capacity-slots"><h2>Shared capacity</h2><p>Total <strong t-out="totals['shared']"/> · Reservation free <strong t-out="totals['reservation']"/> · Walk-in free <strong t-out="totals['walkin']"/></p><p>Each slot has one shared total across all its capabilities. An area arrangement adds no capacity.</p>
                    <h3>Area totals without capability duplication</h3><table class="table"><thead><tr><th>Area</th><th>Time</th><th>Shared total</th><th>Reservation</th><th>Walk-in</th></tr></thead><tbody><tr t-foreach="area_summaries" t-as="row"><td t-out="row['area']"/><td><t t-out="format_time(row['start'])"/> - <t t-out="format_time(row['end'])"/></td><td t-out="row['total']"/><td t-out="row['reservation']"/><td t-out="row['walkin']"/></tr></tbody></table><table class="table"><thead><tr><th>Workstation</th><th>Time</th><th>Capabilities</th><th>Shared total</th><th>Reservation</th><th>Walk-in</th><th>Unavailable</th><th>State and actions</th></tr></thead><tbody>
                    <tr t-foreach="slots" t-as="slot"><td t-out="slot.name"/><td><t t-out="format_time(slot.ydental_start)"/> - <t t-out="format_time(slot.ydental_end)"/></td><td><t t-foreach="slot.ydental_capability_ids" t-as="capability"><span class="badge text-bg-secondary me-1" t-out="capability.name"/></t></td><td t-out="slot.ydental_total"/><td><t t-out="slot.ydental_reservation_free"/><strong class="text-warning" t-if="slot.ydental_policy_id._split(slot.ydental_total)[0] == 0"> Zero reservation allocation</strong></td><td t-out="slot.ydental_walkin_free"/><td t-out="slot.ydental_unavailable"/><td><span t-out="slot.state"/><t t-if="can_write">
                        <details><summary>Verify and publish supply</summary><form method="post" action="/ydental/supply/action"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="publish"/><input type="hidden" name="id" t-att-value="slot.id"/><input type="hidden" name="version" t-att-value="slot.ydental_version"/><label>Verified capability coverage</label><select name="user_ids" multiple="multiple" required="required" class="form-select"><t t-foreach="members" t-as="member"><option t-att-value="member.ydental_user_id.id" t-out="member.ydental_user_id.name"/></t></select><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-primary">Publish verified supply</button></form></details>
                        <details><summary>Change total</summary><form method="post" action="/ydental/supply/action"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="resize"/><input type="hidden" name="id" t-att-value="slot.id"/><input type="hidden" name="version" t-att-value="slot.ydental_version"/><input type="number" name="total" min="0" max="10000" t-att-value="slot.ydental_total"/><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-primary">Save total</button></form></details>
                        <details><summary>Extend slot</summary><form method="post" action="/ydental/supply/action"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="extend"/><input type="hidden" name="id" t-att-value="slot.id"/><input type="hidden" name="version" t-att-value="slot.ydental_version"/><input type="datetime-local" name="end" required="required"/><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-primary">Extend and verify again</button></form></details>
                        <form method="post" action="/ydental/supply/action"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="convert"/><input type="hidden" name="id" t-att-value="slot.id"/><button class="btn btn-outline-secondary">Convert unused reservations</button></form>
                    </t></td></tr></tbody></table>
                    <details t-if="can_write"><summary>Temporary opening or new capacity slot</summary><form method="post" action="/ydental/supply/action" class="p-3"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="slot"/><label>Workstation</label><select name="station_id" class="form-select" required="required"><t t-foreach="stations" t-as="station"><option t-att-value="station.id" t-out="station.name"/></t></select><label>Capabilities</label><select name="capability_ids" multiple="multiple" required="required" class="form-select"><t t-foreach="capabilities" t-as="capability"><option t-att-value="capability.id" t-out="capability.name"/></t></select><t t-call="ydental_supply.ydental_supply_times"/><label>Total</label><input name="total" type="number" min="1" max="10000" required="required"/><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-primary">Create capacity slot</button></form></details>
                </section>
                <section class="card p-3 mb-4" id="business-day"><h2>Area business day</h2><p>Stop ordinary reporting first. Stopping ordinary calling requires the connected queue to be empty.</p><t t-foreach="businesses" t-as="business"><p><t t-out="business.name"/>: <strong t-out="business.state"/> (<t t-out="business.ydental_date"/>)</p><form t-if="can_write" method="post" action="/ydental/supply/action" class="mb-2"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="business"/><input type="hidden" name="area_id" t-att-value="business.ydental_area_id.id"/><input type="hidden" name="version" t-att-value="business.ydental_version"/><select name="state"><option value="draining">Stop ordinary reporting</option><option value="closed">Stop ordinary calling</option><option value="open">Reopen with reason</option></select><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-primary">Save business state</button></form></t><form t-if="can_write" method="post" action="/ydental/supply/action"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="business"/><input type="hidden" name="state" value="open"/><label>Open a reporting area today</label><select name="area_id" required="required"><t t-foreach="areas.filtered('ydental_reporting')" t-as="area"><option t-att-value="area.id" t-out="area.name"/></t></select><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-primary">Open local business day</button></form></section>
                <section class="card p-3 mb-4" id="handling"><h2>Feedback and future handling</h2><p>Review replacement, migration and contact without deleting existing entitlements.</p><t t-foreach="[('feedback', feedback), ('disposition', dispositions)]" t-as="collection"><t t-foreach="collection[1]" t-as="item"><article class="border-bottom py-2"><strong t-out="item.name"/>: <t t-out="item.ydental_reason"/> · <span t-out="item.state"/><p t-out="item.ydental_resolution"/><form t-if="can_write and item.state == 'pending'" method="post" action="/ydental/supply/action"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="resolve"/><input type="hidden" name="entity" t-att-value="collection[0]"/><input type="hidden" name="id" t-att-value="item.id"/><input type="hidden" name="version" t-att-value="item.ydental_version"/><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-outline-primary">Record handling result</button></form></article></t></t></section>
                <details><summary>Supply ledger</summary><table class="table"><thead><tr><th>Event</th><th>Reason</th><th>Before</th><th>After</th></tr></thead><tbody><tr t-foreach="events" t-as="event"><td t-out="event.ydental_operation"/><td t-out="event.ydental_reason"/><td t-out="event.ydental_before"/><td t-out="event.ydental_after"/></tr></tbody></table></details>
            </main>
        </t>
    </template>
    <template id="ydental_supply_today" name="My today">
        <t t-call="web.layout"><t t-set="title">My today</t><main class="container py-4 o_ydental_supply_today">
            <nav><a href="/odoo">YDental</a> / <a href="/ydental/access">Store and access</a> / <a href="/ydental/supply">Weekly plan</a></nav><h1>My today</h1><p>Arrangements are suggestions. This session keeps its selected store until you change it.</p><p t-if="execution_store_id">Global execution store: <t t-out="execution_store_id"/></p>
            <p t-if="len(candidate_ids) > 1">Multiple suggested stores. Choose a store.</p><form method="post" action="/ydental/access/action"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="revision" t-att-value="revision"/><input type="hidden" name="operation" value="switch"/><select name="store_id"><t t-foreach="stores" t-as="store"><option t-att-value="store.id" t-att-selected="store.id == selected_store_id"><t t-out="store.name"/><t t-if="store.id in candidate_ids"> (suggested)</t></option></t></select><button class="btn btn-primary">Select store for this session</button></form>
            <div t-if="not assignments" class="alert alert-info mt-3">No effective arrangement today. Select an authorized store.</div>
            <article t-foreach="assignments" t-as="assignment" class="card p-3 mt-3"><h2 t-out="assignment.ydental_store_id.name"/><p><t t-out="format_time(assignment, assignment.ydental_start)"/> - <t t-out="format_time(assignment, assignment.ydental_end)"/></p><p t-out="assignment.ydental_station_id.name or assignment.ydental_area_id.name"/><p class="text-warning" t-out="assignment.ydental_warning"/>
                <form method="post" action="/ydental/supply/action"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="suggest"/><input type="hidden" name="id" t-att-value="assignment.id"/><button class="btn btn-outline-primary">Enter suggested workbench</button></form>
                <details class="mt-2"><summary>Arrangement is wrong</summary><p>Sent to this store's schedule editors. If none are available, ask the store manager to handle it.</p><form method="post" action="/ydental/supply/action"><t t-call="ydental_supply.ydental_supply_tokens"/><input type="hidden" name="operation" value="feedback"/><input type="hidden" name="id" t-att-value="assignment.id"/><t t-call="ydental_supply.ydental_supply_reason"/><button class="btn btn-primary">Report arrangement error</button></form></details>
            </article>
        </main></t>
    </template>
    <template id="ydental_supply_suggestion" name="Suggested workbench">
        <t t-call="web.layout"><t t-set="title">Suggested workbench</t><main class="container py-4"><h1>Suggested workbench</h1><p t-out="result['message']"/><ul><li t-foreach="stations" t-as="station" t-out="station.name"/></ul><a href="/ydental/supply/today">Back to my today</a></main></t>
    </template>
</odoo>
