<odoo>
    <record id="ydental_intake_action" model="ir.actions.act_url"><field name="name">Service intake</field><field name="url">/ydental/intake</field><field name="target">self</field></record>
    <record id="ydental_intake_price_action" model="ir.actions.act_url"><field name="name">Service catalog and prices</field><field name="url">/ydental/intake/prices</field><field name="target">self</field></record>
    <menuitem id="ydental_intake_menu" name="Service intake" parent="ydental_base.ydental_base_menu_root" action="ydental_intake_action" sequence="50" groups="ydental_base.ydental_base_group_user"/>
    <menuitem id="ydental_intake_price_menu" name="Service catalog and prices" parent="ydental_base.ydental_base_menu_root" action="ydental_intake_price_action" sequence="51" groups="ydental_base.ydental_base_group_user"/>
    <template id="ydental_intake_tokens">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="revision" t-att-value="revision"/>
        <input type="hidden" name="key" t-att-value="key()"/>
    </template>
    <template id="ydental_intake_nav"><nav class="d-flex gap-3 mb-3"><a href="/odoo">YDental</a><a href="/ydental/access">Store and access</a><a href="/ydental/patients">Patients</a><a href="/ydental/intake">Service intake</a><a href="/ydental/intake/prices">Catalog and prices</a></nav></template>
    <template id="ydental_intake_catalog_select"><label>Service <select name="catalog_id" required="required"><option t-foreach="catalogs" t-as="c" t-att-value="c.id" t-out="c.name"/></select></label></template>
    <template id="ydental_intake_currency_select"><label>Currency <select name="currency_id" required="required"><option t-foreach="currencies" t-as="c" t-att-value="c.id" t-out="c.name"/></select></label></template>
    <template id="ydental_intake_mapping_select"><label>Service and reporting area <select name="mapping_id" required="required"><option t-foreach="mappings" t-as="m" t-att-value="m.id" t-out="m.name"/></select></label></template>
    <template id="ydental_intake_patient_select"><label>Patient <select name="patient_id" required="required"><option t-foreach="patients" t-as="p" t-att-value="p.id"><t t-out="p.ydental_number"/> <t t-out="p.name"/></option></select></label></template>
    <template id="ydental_intake_times"><label>Slot start (UTC) <input type="datetime-local" name="start" required="required"/></label><label>Slot end (UTC) <input type="datetime-local" name="end" required="required"/></label></template>
    <template id="ydental_intake_reason"><label>Reason <input name="reason" required="required" maxlength="300"/></label></template>
    <template id="ydental_intake_page" name="Service intake">
        <t t-call="web.layout"><t t-set="title">Service intake</t><main class="container py-4">
            <t t-call="ydental_intake.ydental_intake_nav"/><h1>Service intake</h1><h2 t-out="store.name"/>
            <p>Qualification, actual arrival and reporting are separate. A pending task has no queue number. Calling is awaiting the next phase.</p>
            <section t-if="can_frontdesk" id="intake-create"><h3>New qualification</h3>
                <form method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/>
                    <label>Reception type <select name="operation"><option value="reserve">Reservation</option><option value="register">Walk-in registration only</option><option value="walkin_report">Walk-in registration and reporting</option></select></label>
                    <t t-call="ydental_intake.ydental_intake_patient_select"/><t t-call="ydental_intake.ydental_intake_mapping_select"/><t t-call="ydental_intake.ydental_intake_times"/><button>Acquire qualification</button>
                </form><h3>Record actual arrival</h3><form method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" value="arrive"/><t t-call="ydental_intake.ydental_intake_patient_select"/><button>Confirm actual arrival</button></form>
            </section>
            <h3>Actual arrivals</h3><ul><li t-foreach="arrivals" t-as="a"><t t-out="a.name"/>: <t t-out="a.ydental_occurred_at"/></li></ul>
            <h3>Accepted positions</h3><ul id="accepted-positions"><li t-foreach="positions" t-as="p"><t t-out="p.ydental_patient_id.ydental_number"/>: <t t-out="p.name"/></li></ul>
            <h3>Service tasks</h3><table class="table" id="intake-tasks"><thead><tr><th>Patient</th><th>Service and area</th><th>Status</th><th>Actions</th></tr></thead><tbody><tr t-foreach="tasks" t-as="task" t-att-data-task="task.id"><td t-out="task.ydental_patient_id.ydental_number"/><td t-out="task.name"/><td t-out="dict(task._fields['state']._description_selection(task.env))[task.state]"/><td t-if="can_frontdesk and task.state in ('pending', 'accepted')">
                <form method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" value="report"/><input type="hidden" name="task_id" t-att-value="task.id"/><input type="hidden" name="version" t-att-value="task.ydental_version"/><button>Report this task</button></form>
                <details><summary>Void position</summary><form method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" value="void"/><input type="hidden" name="task_id" t-att-value="task.id"/><input type="hidden" name="version" t-att-value="task.ydental_version"/><t t-call="ydental_intake.ydental_intake_reason"/><label>Qualification <select name="cancel_qualification"><option value="no">Keep valid qualification</option><option value="yes">Also cancel unused qualification</option></select></label><p>This does not cancel orders, record clinical completion or refund fees.</p><button>Confirm void</button></form></details>
            </td></tr></tbody></table>
            <h3>Qualifications</h3><table class="table"><thead><tr><th>Patient</th><th>Service</th><th>State</th><th>Changes</th></tr></thead><tbody><tr t-foreach="entitlements" t-as="e"><td t-out="e.ydental_patient_id.ydental_number"/><td t-out="e.name"/><td t-out="dict(e._fields['state']._description_selection(e.env))[e.state]"/><td t-if="can_frontdesk and e.state == 'held'">
                <details><summary>Cancel qualification</summary><form method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" value="cancel"/><input type="hidden" name="record_id" t-att-value="e.id"/><input type="hidden" name="version" t-att-value="e.ydental_version"/><t t-call="ydental_intake.ydental_intake_reason"/><button>Cancel and return capacity once</button></form></details>
                <details><summary>Reschedule</summary><form method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" value="reschedule"/><input type="hidden" name="record_id" t-att-value="e.id"/><input type="hidden" name="version" t-att-value="e.ydental_version"/><t t-call="ydental_intake.ydental_intake_mapping_select"/><t t-call="ydental_intake.ydental_intake_times"/><t t-call="ydental_intake.ydental_intake_reason"/><button>Acquire new slot and release old</button></form></details>
            </td></tr></tbody></table>
            <h3>Untimed referrals for this store</h3><div t-foreach="referrals" t-as="r"><p><t t-out="r.name"/>: <t t-out="r.ydental_valid_until"/></p><form t-if="can_frontdesk" method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" value="accept_referral"/><input type="hidden" name="record_id" t-att-value="r.id"/><input type="hidden" name="version" t-att-value="r.ydental_version"/><t t-call="ydental_intake.ydental_intake_times"/><button>Acquire target walk-in qualification</button></form></div>
        </main></t>
    </template>
    <template id="ydental_intake_price_page" name="Service catalog and prices">
        <t t-call="web.layout"><t t-set="title">Service catalog and prices</t><main class="container py-4"><t t-call="ydental_intake.ydental_intake_nav"/><h1>Service catalog and prices</h1><h2 t-out="store.name"/><p class="alert alert-warning">Production price locking policy is awaiting business approval. Demonstration snapshots are not confirmed fees.</p>
            <section t-if="can_catalog" id="create-catalog"><h3>Add group service</h3><form method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" value="catalog"/><label>Code <input name="code" required="required"/></label><label>Name <input name="name" required="required"/></label><label>Category <select name="kind"><option value="care">Outpatient</option><option value="exam">Examination</option><option value="medicine">Medicine</option><option value="procedure">Procedure</option><option value="prosthesis">Prosthesis</option></select></label><label>Capability <select name="capability_id"><option t-foreach="capabilities" t-as="c" t-att-value="c.id" t-out="c.name"/></select></label><label>Unit <select name="uom_id"><option t-foreach="uoms" t-as="u" t-att-value="u.id" t-out="u.name"/></select></label><label>Qualification <input name="qualification"/></label><button>Add service</button></form></section>
            <h3>Group catalog</h3><table class="table"><tbody><tr t-foreach="catalogs" t-as="c"><td t-out="c.ydental_code"/><td t-out="c.name"/><td t-out="c.ydental_capability_id.name"/><td><form t-if="can_catalog" method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" value="catalog_edit"/><input type="hidden" name="record_id" t-att-value="c.id"/><input type="hidden" name="version" t-att-value="c.ydental_version"/><input name="name" t-att-value="c.name" required="required"/><select name="active"><option value="yes" t-att-selected="c.active">Enabled</option><option value="no" t-att-selected="not c.active">Disabled</option></select><button>Save catalog</button></form></td></tr></tbody></table>
            <section t-if="can_price"><h3>Map store service areas</h3><form method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" value="mapping"/><t t-call="ydental_intake.ydental_intake_catalog_select"/><label>Reporting area <select name="area_id"><option t-foreach="areas" t-as="a" t-att-value="a.id" t-out="a.name"/></select></label><label>Execution area <select name="execution_area_id"><option t-foreach="areas" t-as="a" t-att-value="a.id" t-out="a.name"/></select></label><button>Map service</button></form>
                <h3>Create price version</h3><form id="create-price" method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" value="price"/><t t-call="ydental_intake.ydental_intake_catalog_select"/><t t-call="ydental_intake.ydental_intake_currency_select"/><label>Unit price <input type="number" step="any" min="0.000001" name="unit_price" required="required"/></label><t t-call="ydental_intake.ydental_intake_times"/><t t-call="ydental_intake.ydental_intake_reason"/><button>Create draft price</button></form>
            </section><h3>Price versions</h3><table class="table" id="price-versions"><thead><tr><th>Service</th><th>Price</th><th>Validity UTC</th><th>Status</th><th>Action</th></tr></thead><tbody><tr t-foreach="prices" t-as="p" t-att-data-price="p.id"><td t-out="p.name"/><td><t t-out="p.ydental_unit_price"/> <t t-out="p.ydental_currency_id.name"/></td><td><t t-out="p.ydental_start"/> / <t t-out="p.ydental_end"/></td><td t-out="dict(p._fields['state']._description_selection(p.env))[p.state]"/><td><form t-if="can_price and p.state in ('draft', 'reviewed')" method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" t-att-value="'review' if p.state == 'draft' else 'publish'"/><input type="hidden" name="record_id" t-att-value="p.id"/><input type="hidden" name="version" t-att-value="p.ydental_version"/><t t-call="ydental_intake.ydental_intake_reason"/><t t-if="p.state == 'reviewed'"><label>Replace price version (optional) <input type="number" name="replace_id"/></label><label>Replacement current version <input type="number" name="replace_version"/></label></t><button t-out="'Review' if p.state == 'draft' else 'Publish'"/></form></td></tr></tbody></table>
            <h3>Preview and freeze demonstration price</h3><form id="demo-snapshot" method="post" action="/ydental/intake/action"><t t-call="ydental_intake.ydental_intake_tokens"/><input type="hidden" name="operation" value="snapshot"/><input type="hidden" name="policy" value="demo_confirmation"/><t t-call="ydental_intake.ydental_intake_catalog_select"/><t t-call="ydental_intake.ydental_intake_currency_select"/><label>Actual quantity <input type="number" step="any" name="quantity" required="required" value="1"/></label><label>Demonstration reference <input name="source" required="required" maxlength="300"/></label><button>Confirm demonstration snapshot</button></form>
            <ul id="price-snapshots"><li t-foreach="snapshots" t-as="s"><t t-out="s.name"/>: <t t-out="s.ydental_product_name"/> <t t-out="s.ydental_amount"/> <t t-out="s.ydental_currency_id.name"/> / <t t-out="s.ydental_quoted_at"/> / <t t-out="s.ydental_policy"/></li></ul>
        </main></t>
    </template>
</odoo>
