<odoo>
    <record id="ydental_settlement_action" model="ir.actions.act_url">
        <field name="name">Offline settlement workbench</field>
        <field name="url">/ydental/settlement</field>
        <field name="target">self</field>
    </record>
    <menuitem id="ydental_settlement_menu" name="Offline settlement" parent="ydental_base.ydental_base_menu_root" action="ydental_settlement_action" sequence="84" groups="ydental_base.ydental_base_group_user"/>

    <template id="ydental_settlement_tokens">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        <input type="hidden" name="revision" t-att-value="revision"/>
        <input type="hidden" name="key" t-att-value="new_key()"/>
        <input type="hidden" name="output" value="html"/>
    </template>

    <template id="ydental_settlement_page_links">
        <nav t-if="page_counts[page_kind] &gt; 50" aria-label="分页">
            <span>共 <span t-out="page_counts[page_kind]"/> 条；第 <span t-out="pages[page_kind]"/> 页</span>
            <a t-if="pages[page_kind] &gt; 1" t-att-href="page_url(page_kind, pages[page_kind] - 1)" t-att-class="'o_ydental_settlement_action o_ydental_settlement_action_secondary' if settlement_readonly_actions else None" t-att-data-dl-actions="'settlement-readonly-actions' if settlement_readonly_actions else None"><t t-if="settlement_readonly_actions"><t t-call="ydental_inventory.p7_icon_chevron_left"/><span class="o_ydental_settlement_action_label" t-translation="on">上一页</span></t><t t-else="">上一页</t></a>
            <a t-if="pages[page_kind] * 50 &lt; page_counts[page_kind]" t-att-href="page_url(page_kind, pages[page_kind] + 1)" t-att-class="'o_ydental_settlement_action o_ydental_settlement_action_secondary' if settlement_readonly_actions else None" t-att-data-dl-actions="'settlement-readonly-actions' if settlement_readonly_actions else None"><t t-if="settlement_readonly_actions"><span class="o_ydental_settlement_action_label" t-translation="on">下一页</span><t t-call="ydental_inventory.p7_icon_chevron_right"/></t><t t-else="">下一页</t></a>
        </nav>
    </template>

    <template id="ydental_settlement_page" name="Offline settlement workbench">
        <t t-set="head"><meta name="viewport" content="width=device-width, initial-scale=1"/>
            <t t-call-assets="web.assets_frontend" t-js="false"/></t>
        <t t-call="web.layout" head="head">
            <main class="container py-4 o_ydental_settlement" t-att-data-revision="revision">
                <h1>线下结算工作台</h1>
                <p t-if="feedback" role="status" data-ui1-feedback="1" t-out="feedback"/>
                <p>当前门店：<strong t-out="store.name"/>；仅记录人工确认实际发生的线下资金。本页为演示，不是税务发票或平台到账证明。</p>
                <nav><a href="/ydental/queue">前台与候诊</a> | <a href="/ydental/access">门店与权限</a></nav>
                <div class="o_ydental_settlement_lookup" data-dl-scope="settlement-lookup">
                    <section class="o_ydental_access_search o_ydental_settlement_search" data-dl-region="search" aria-labelledby="ydental-settlement-lookup-heading">
                        <h2 id="ydental-settlement-lookup-heading">Patient lookup</h2>
                        <form method="get" action="/ydental/settlement" class="o_ydental_settlement_search_form">
                            <label class="o_ydental_settlement_search_label">Patient name or number
                                <input name="q" maxlength="100" t-att-value="search_term" aria-describedby="ydental-settlement-search-help"/>
                            </label>
                            <button type="submit" class="o_ydental_settlement_search_button o_ydental_settlement_action o_ydental_settlement_action_primary" data-dl-actions="settlement-readonly-actions"><t t-call="ydental_inventory.p7_icon_search"/><span class="o_ydental_settlement_action_label" t-translation="on">Search for a patient</span></button>
                        </form>
                        <p class="o_ydental_settlement_help">Only patients related to the current authorized store are listed. Names and patient numbers distinguish matching names.</p>
                        <p id="ydental-settlement-search-help" class="o_ydental_settlement_help">Searching lists candidates only. Open a patient link to select a patient. Submitting a new search clears the previous selection.</p>
                        <ul class="o_ydental_settlement_candidates">
                            <li t-foreach="patient_options['rows']" t-as="option">
                                <a t-att-href="'/ydental/settlement?patient_id=%s' % option['id']" class="o_ydental_settlement_action o_ydental_settlement_action_quiet" data-dl-actions="settlement-readonly-actions"><span t-out="option['name']"/> · <span class="o_ydental_settlement_patient_number" t-out="option['number']"/></a>
                            </li>
                        </ul>
                        <div t-if="not patient_options['rows']" class="o_ydental_settlement_empty">
                            <p>No matching patients in this store.</p>
                            <p>An empty candidate result does not mean there are no fees or that bills are settled.</p>
                        </div>
                        <nav class="o_ydental_settlement_search_pager" aria-label="Patient lookup pages">
                            <a t-if="patient_options['page'] &gt; 1" t-att-href="patient_search_url(patient_options['page'] - 1)" class="o_ydental_settlement_action o_ydental_settlement_action_secondary" data-dl-actions="settlement-readonly-actions"><t t-call="ydental_inventory.p7_icon_chevron_left"/><span class="o_ydental_settlement_action_label" t-translation="on">Previous search page</span></a>
                            <span t-else="" class="o_ydental_settlement_page_boundary">First patient lookup page</span>
                            <span class="o_ydental_settlement_page_number"><t>Patient lookup page:</t> <t t-out="patient_options['page']"/></span>
                            <a t-if="patient_options['has_more']" t-att-href="patient_search_url(patient_options['page'] + 1)" class="o_ydental_settlement_action o_ydental_settlement_action_secondary" data-dl-actions="settlement-readonly-actions"><span class="o_ydental_settlement_action_label" t-translation="on">Next search page</span><t t-call="ydental_inventory.p7_icon_chevron_right"/></a>
                            <span t-else="" class="o_ydental_settlement_page_boundary">No later patient lookup page</span>
                        </nav>
                    </section>
                    <section class="o_ydental_settlement_context" data-dl-region="selected-patient" aria-label="Current fee overview scope">
                        <p t-if="patient" class="o_ydental_settlement_selected"><t>Currently selected patient number:</t> <strong t-out="patient.ydental_number"/></p>
                        <p t-else="" class="o_ydental_settlement_selected">No patient is currently selected.</p>
                        <p t-if="patient">The fee tables below cover the selected patient in the current store, including merged source records.</p>
                        <p t-else="">The fee tables below cover the current store. Searching candidates does not filter these fees.</p>
                        <p class="o_ydental_settlement_help">Unbilled fees are not receivables. Confirmed amounts are not receipts. These tables are not a balance or a total.</p>
                        <p t-if="patient" class="o_ydental_settlement_other_stores"><a t-att-href="'/ydental/settlement/other-stores/%s' % patient.id" class="o_ydental_settlement_action o_ydental_settlement_action_quiet" data-dl-actions="settlement-readonly-actions"><span class="o_ydental_settlement_action_label" t-translation="on">查看其他门店欠款最小摘要</span><t t-call="ydental_inventory.p7_icon_arrow_right"/></a></p>
                    </section>
                    <div class="o_ydental_settlement_fee_overview" data-dl-region="fee-overview">
                        <section class="o_ydental_settlement_fee_section" data-fee-kind="today" aria-labelledby="ydental-settlement-today-heading">
                            <h2 id="ydental-settlement-today-heading">今日未出账费用</h2>
                            <p t-if="not today" class="o_ydental_settlement_empty">No matching records on this page in the current fee scope.</p>
                            <p t-if="today" class="o_ydental_settlement_scroll_help" id="ydental-settlement-today-scroll-help">Wide table: scroll sideways to read all columns. With the table focused, use the left and right arrow keys.</p>
                            <div t-if="today" class="o_ydental_access_scroll o_ydental_settlement_fee_scroll" tabindex="0" role="region" aria-label="Today unbilled fee table" aria-describedby="ydental-settlement-today-scroll-help">
                                <table t-if="today" class="table o_ydental_settlement_fee_table"><thead><tr><th scope="col">Fee item</th><th scope="col">患者</th><th scope="col" class="o_ydental_settlement_amount">确认金额</th><th scope="col">业务日</th><th scope="col">Trace</th></tr></thead>
                                    <tbody><tr t-foreach="today" t-as="fee"><td t-out="fee.ydental_event_id.ydental_catalog_id.name"/><td t-out="fee.ydental_patient_id.ydental_number"/>
                                        <td class="o_ydental_settlement_amount" t-out="money(fee.ydental_amount, fee.ydental_currency_id)"/><td t-out="fee.ydental_event_id.ydental_business_date"/><td><details><summary class="o_ydental_settlement_disclosure" data-dl-actions="settlement-readonly-actions">Source trace</summary><span class="o_ydental_settlement_trace_body">Fee reference <t t-out="fee.id"/>; original name <t t-out="fee.name"/>; execution event <t t-out="fee.ydental_event_id.id"/></span></details></td></tr></tbody>
                                </table>
                            </div><t t-set="page_kind" t-value="'today'"/><t t-call="ydental_settlement.ydental_settlement_page_links" settlement_readonly_actions="True"/>
                        </section>
                        <section class="o_ydental_settlement_fee_section" data-fee-kind="history" aria-labelledby="ydental-settlement-history-heading">
                            <h2 id="ydental-settlement-history-heading">历史未出账费用</h2>
                            <p t-if="not history" class="o_ydental_settlement_empty">No matching records on this page in the current fee scope.</p>
                            <p t-if="history" class="o_ydental_settlement_scroll_help" id="ydental-settlement-history-scroll-help">Wide table: scroll sideways to read all columns. With the table focused, use the left and right arrow keys.</p>
                            <div t-if="history" class="o_ydental_access_scroll o_ydental_settlement_fee_scroll" tabindex="0" role="region" aria-label="Other-date unbilled fee table" aria-describedby="ydental-settlement-history-scroll-help">
                                <table t-if="history" class="table o_ydental_settlement_fee_table"><thead><tr><th scope="col">Fee item</th><th scope="col">患者</th><th scope="col" class="o_ydental_settlement_amount">确认金额</th><th scope="col">业务日</th><th scope="col">Trace</th></tr></thead><tbody><tr t-foreach="history" t-as="fee">
                                    <td t-out="fee.ydental_event_id.ydental_catalog_id.name"/><td t-out="fee.ydental_patient_id.ydental_number"/><td class="o_ydental_settlement_amount" t-out="money(fee.ydental_amount, fee.ydental_currency_id)"/>
                                    <td t-out="fee.ydental_event_id.ydental_business_date"/><td><details><summary class="o_ydental_settlement_disclosure" data-dl-actions="settlement-readonly-actions">Source trace</summary><span class="o_ydental_settlement_trace_body">Fee reference <t t-out="fee.id"/>; original name <t t-out="fee.name"/>; execution event <t t-out="fee.ydental_event_id.id"/></span></details></td></tr></tbody></table>
                            </div><t t-set="page_kind" t-value="'history'"/><t t-call="ydental_settlement.ydental_settlement_page_links" settlement_readonly_actions="True"/>
                        </section>
                        <section class="o_ydental_settlement_fee_section o_ydental_settlement_pending" data-fee-kind="pending" aria-labelledby="ydental-settlement-pending-heading">
                            <h2 id="ydental-settlement-pending-heading">待核对，禁止出账</h2>
                            <p t-if="not pending" class="o_ydental_settlement_empty">No matching records on this page in the current fee scope.</p>
                            <p t-if="pending" class="o_ydental_settlement_scroll_help" id="ydental-settlement-pending-scroll-help">Wide table: scroll sideways to read all columns. With the table focused, use the left and right arrow keys.</p>
                            <div t-if="pending" class="o_ydental_access_scroll o_ydental_settlement_fee_scroll" tabindex="0" role="region" aria-label="Pending reconciliation fee table" aria-describedby="ydental-settlement-pending-scroll-help">
                                <table t-if="pending" class="table o_ydental_settlement_fee_table"><thead><tr><th scope="col">Item awaiting reconciliation</th><th scope="col">患者</th><th scope="col">业务日</th><th scope="col">实际执行人</th><th scope="col">待核对原因</th></tr></thead>
                                    <tbody><tr t-foreach="pending" t-as="event">
                                        <td><t t-out="event.ydental_catalog_id.name"/><details><summary class="o_ydental_settlement_disclosure" data-dl-actions="settlement-readonly-actions">Source trace</summary><span class="o_ydental_settlement_trace_body">Execution event <t t-out="event.id"/>; original name <t t-out="event.name"/></span></details></td><td t-out="event.ydental_patient_id.ydental_number"/>
                                        <td t-out="event.ydental_business_date"/><td t-out="event.ydental_actor_id.name"/>
                                        <td t-out="event.ydental_pending_reason or '待核对'"/></tr></tbody></table>
                            </div><t t-set="page_kind" t-value="'pending'"/><t t-call="ydental_settlement.ydental_settlement_page_links" settlement_readonly_actions="True"/>
                        </section>
                    </div>
                </div>
                <details name="settlement-operation" class="o_ydental_access_operation" t-if="can_write and (today or history)"><summary>Select fees to bill</summary><form method="post" action="/ydental/settlement/action">
                    <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                    <input type="hidden" name="operation" value="bill"/>
                    <h3>选择本店已确认费用出账</h3>
                    <label t-foreach="today | history" t-as="fee" style="display:block">
                        <input type="checkbox" name="fee_ids" t-att-value="fee.id"/>
                        <span t-out="fee.ydental_event_id.ydental_catalog_id.name"/> · <span t-out="fee.ydental_patient_id.ydental_number"/> · <span t-out="fee.ydental_event_id.ydental_business_date"/>：<span t-out="money(fee.ydental_amount, fee.ydental_currency_id)"/>
                    </label>
                    <label>明确折扣金额 <input type="number" name="discount" min="0" step="0.01" value="0"/></label>
                    <label>折扣原因 <input type="text" name="reason" maxlength="300"/></label>
                    <button type="submit">生成原生过账账单</button>
                </form>
                <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details><section><h2>已出账未付清</h2><p t-if="not invoices">无</p>
                    <div class="o_ydental_access_scroll" tabindex="0" aria-label="Scrollable details"><table t-if="invoices" class="table"><thead><tr><th>原生单号</th><th>业务日</th><th>原金额</th><th>应收余额</th><th>内部账单</th></tr></thead>
                        <tbody><tr t-foreach="invoices" t-as="invoice" t-att-id="'invoice-%s' % invoice.id">
                            <td t-out="invoice.name"/><td t-out="invoice.invoice_date"/>
                            <td t-out="money(invoice.amount_total, invoice.currency_id)"/><td t-out="money(invoice.amount_residual, invoice.currency_id)"/>
                            <td><a t-if="can_export" t-att-href="'/ydental/settlement/pdf/bill/%s' % invoice.id">下载中文 PDF</a>
                                <span t-else="">仅供查阅</span>
                                <details name="settlement-operation" class="o_ydental_access_operation" t-if="can_write"><summary>Waive receivable with evidence</summary><form method="post" action="/ydental/settlement/action">
                                    <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                                    <input type="hidden" name="operation" value="waive"/>
                                    <input type="hidden" name="invoice_id" t-att-value="invoice.id"/>
                                    <label>未收款免单额 <input type="number" name="amount" min="0.01" step="0.01" required="required"/></label>
                                    <label>有据免单原因 <input type="text" name="reason" maxlength="300" required="required"/></label>
                                    <button type="submit">原生贷项冲减未收应收</button>
                                </form>
                            <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details></td>
                        </tr></tbody></table>
                    </div><t t-set="page_kind" t-value="'invoices'"/><t t-call="ydental_settlement.ydental_settlement_page_links"/>
                </section>
                <details name="settlement-operation" class="o_ydental_access_operation" t-if="can_write and invoices"><summary>Record actual collection</summary><form method="post" action="/ydental/settlement/action">
                    <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                    <input type="hidden" name="operation" value="pay"/>
                    <h3>仅选择本次付款核销的账单</h3>
                    <label t-foreach="invoices" t-as="invoice" style="display:block"><input type="checkbox" name="invoice_ids" t-att-value="invoice.id"/>
                        <span t-out="invoice.name"/>，应收 <span t-out="money(invoice.amount_residual, invoice.currency_id)"/></label>
                    <label>实际收款 <input type="number" name="amount" min="0.01" step="0.01" required="required"/></label>
                    <label>线下方式 <select name="channel"><option value="cash">现金</option><option value="wechat">微信线下</option>
                        <option value="alipay">支付宝线下</option><option value="card">银行卡线下</option></select></label>
                    <label>实际发生 UTC <input type="text" name="actual_utc" t-att-value="now_utc()" required="required"/></label>
                    <label>真实线下凭据说明 <input type="text" name="proof" maxlength="200" required="required"/></label>
                    <button type="submit">确认实际收款并原生核销</button>
                </form>
                <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details><section name="settled-bills">
                    <h2>已结清本店账单</h2><p t-if="not settled">本页无已结清本店账单。</p>
                    <div class="o_ydental_access_scroll" tabindex="0" aria-label="Scrollable details"><table t-if="settled" class="table">
                        <thead><tr><th>原生单号</th><th>业务日</th><th>总额</th><th>已结清余额</th><th>内部账单</th></tr></thead>
                        <tbody><tr t-foreach="settled" t-as="invoice" t-att-id="'invoice-%s' % invoice.id">
                            <td><t t-out="invoice.name"/><details><summary>Source trace</summary>Bill key <t t-out="invoice.id"/></details></td><td t-out="invoice.invoice_date"/>
                            <td t-out="money(invoice.amount_total, invoice.currency_id)"/><td t-out="money(invoice.amount_residual, invoice.currency_id)"/>
                            <td><a t-if="can_export" t-att-href="'/ydental/settlement/pdf/bill/%s' % invoice.id">下载当前内部账单 PDF</a>
                                <span t-else="">仅供查阅</span>
                                <t t-if="can_export">
                                    <form method="post" t-att-action="'/ydental/settlement/bill-original/create/%s' % invoice.id">
                                        <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                                        <input type="hidden" name="previous_id" t-att-value="bill_originals.get(invoice.id, [{}])[0].get('id', '')"/>
                                        <button type="submit">生成并留存内部账单原件</button>
                                    </form>
                                    <p t-foreach="bill_originals.get(invoice.id, [])" t-as="original">
                                        <a t-att-href="'/ydental/settlement/bill-original/%s' % original['id']">下载已留存内部账单原件（版本 <t t-out="original['version']"/>）</a>
                                    </p>
                                </t></td>
                        </tr></tbody>
                    </table>
                    </div><nav t-if="page_counts['settled'] &gt; 50" aria-label="已结清账单分页">
                        <span>共 <span t-out="page_counts['settled']"/> 条；第 <span t-out="pages['settled']"/> 页</span>
                        <a t-if="pages['settled'] &gt; 1" t-att-href="page_url('settled', pages['settled'] - 1)">上一页</a>
                        <a t-if="pages['settled'] &lt; 10000 and pages['settled'] * 50 &lt; page_counts['settled']" t-att-href="page_url('settled', pages['settled'] + 1)">下一页</a>
                    </nav>
                </section>
                <section><h2>线下付款与退款</h2>
                    <div t-foreach="payments" t-as="payment" t-att-id="'payment-%s' % payment.id">
                        <p>Collection <span t-out="payment.ydental_payment_id.name"/>：
                            <span t-out="money(payment.ydental_amount, payment.ydental_currency_id)"/>，<span t-out="channel_labels[payment.ydental_channel]"/>，
                            <a t-if="can_export" t-att-href="'/ydental/settlement/pdf/receipt/%s' % payment.id">下载小票 PDF</a>
                            <span t-else="">仅供查阅</span></p>
                        <details><summary>Source trace</summary>Collection reference <t t-out="payment.id"/>; native payment reference <t t-out="payment.ydental_payment_id.id"/></details>
                        <details name="settlement-operation" class="o_ydental_access_operation" t-if="can_write"><summary>申请退款</summary><form method="post" action="/ydental/settlement/action">
                            <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                            <input type="hidden" name="operation" value="refund_request"/>
                            <input type="hidden" name="payment_id" t-att-value="payment.id"/>
                            <label>申请退款额 <input type="number" name="amount" min="0.01" step="0.01" required="required"/></label>
                            <label>原因 <input type="text" name="reason" maxlength="300" required="required"/></label>
                            <button type="submit">申请退款</button>
                        </form>
                        <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details><details name="settlement-operation" class="o_ydental_access_operation" t-if="can_write"><summary>Correct collection channel</summary><form method="post" action="/ydental/settlement/action">
                            <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                            <input type="hidden" name="operation" value="reclassify"/>
                            <input type="hidden" name="payment_id" t-att-value="payment.id"/>
                            <label>更正线下方式 <select name="new_channel"><option value="cash">现金</option>
                                <option value="wechat">微信线下</option><option value="alipay">支付宝线下</option>
                                <option value="card">银行卡线下</option></select></label>
                            <label>更正原因 <input type="text" name="reason" maxlength="300" required="required"/></label>
                            <button type="submit">原生重分类更正</button>
                        </form>
                    <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details></div>
                    <t t-set="page_kind" t-value="'payments'"/><t t-call="ydental_settlement.ydental_settlement_page_links"/>
                    <div t-foreach="refunds" t-as="refund" t-att-id="'refund-%s' % refund.id">
                        <details><summary>Source trace</summary>Refund reference <t t-out="refund.id"/>; entered UTC <t t-out="refund.create_date"/>; request reason <t t-out="refund.ydental_reason"/></details>
                        <p>Refund request · original collection <span t-out="refund.ydental_payment_id.ydental_payment_id.name"/>：<span t-out="money(refund.ydental_amount, refund.ydental_currency_id)"/>，状态 <span t-out="refund_labels[refund.ydental_state]"/>
                            <a t-if="can_export" t-att-href="'/ydental/settlement/pdf/refund/%s' % refund.id">下载退款凭据 PDF</a>
                            <span t-else="">仅供查阅</span></p>
                        <details name="settlement-operation" class="o_ydental_access_operation" t-if="can_approve and refund.ydental_state == 'requested'"><summary>Review refund request</summary><form method="post" action="/ydental/settlement/action">
                            <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                            <input type="hidden" name="refund_id" t-att-value="refund.id"/>
                            <label>审批原因 <input type="text" name="reason" maxlength="300" required="required"/></label>
                            <button name="operation" value="refund_approve">另一人批准，在途</button>
                            <button name="operation" value="refund_reject">驳回，不退款</button>
                        </form>
                        <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details><details name="settlement-operation" class="o_ydental_access_operation" t-if="can_write and refund.ydental_state == 'approved'"><summary>Confirm actual refund</summary><form method="post" action="/ydental/settlement/action">
                            <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                            <input type="hidden" name="operation" value="refund_execute"/>
                            <input type="hidden" name="refund_id" t-att-value="refund.id"/>
                            <label>实际退款 UTC <input type="text" name="actual_utc" t-att-value="now_utc()" required="required"/></label>
                            <label>实际线下退款凭据 <input type="text" name="proof" maxlength="200" required="required"/></label>
                            <button type="submit">确认已实际退款</button>
                        </form>
                        <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details><details name="settlement-operation" class="o_ydental_access_operation" t-if="can_write and refund.ydental_state == 'approved'"><summary>Record unknown refund result</summary><form method="post" action="/ydental/settlement/action">
                            <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                            <input type="hidden" name="operation" value="refund_uncertain"/>
                            <input type="hidden" name="refund_id" t-att-value="refund.id"/>
                            <label>线下核查状态 <select name="outcome"><option value="unknown">未知</option>
                                <option value="failed">失败</option></select></label>
                            <label>核查原因 <input type="text" name="reason" maxlength="300" required="required"/></label>
                            <button type="submit">标记未知或失败，继续占用额度</button>
                        </form>
                        <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details><details name="settlement-operation" class="o_ydental_access_operation" t-if="can_approve and refund.ydental_state in ('failed', 'unknown') and refund.ydental_requester_id.id != request.env.uid"><summary>Verify no refund before recovery</summary><form method="post" action="/ydental/settlement/action">
                            <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                            <input type="hidden" name="operation" value="refund_recover"/>
                            <input type="hidden" name="refund_id" t-att-value="refund.id"/>
                            <label>已核实未付款 <input type="checkbox" name="verified_not_paid" value="1" required="required"/></label>
                            <label>恢复原因 <input type="text" name="reason" maxlength="300" required="required"/></label>
                            <button type="submit">财务核查后恢复执行</button>
                        </form>
                        <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details><details name="settlement-operation" class="o_ydental_access_operation" t-if="(can_write and refund.ydental_state == 'requested' and refund.ydental_requester_id.id == request.env.uid) or (can_approve and refund.ydental_state in ('requested', 'approved', 'failed', 'unknown') and refund.ydental_requester_id.id != request.env.uid)"><summary>Cancel refund request</summary><form method="post" action="/ydental/settlement/action">
                            <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                            <input type="hidden" name="operation" value="refund_cancel"/>
                            <input type="hidden" name="refund_id" t-att-value="refund.id"/>
                            <label>已核实未实际退款 <input type="checkbox" name="verified_not_paid" value="1" required="required"/></label>
                            <label>线下核查证据 <input type="text" name="evidence" maxlength="200" required="required"/></label>
                            <label>撤销原因 <input type="text" name="reason" maxlength="300" required="required"/></label>
                            <button type="submit">撤销申请并释放受保护额度</button>
                        </form>
                    <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details></div>
                    <t t-set="page_kind" t-value="'refunds'"/><t t-call="ydental_settlement.ydental_settlement_page_links"/>
                </section>
                <section><h2>收费员日结</h2>
                    <details name="settlement-operation" class="o_ydental_access_operation" t-if="can_write"><summary>Complete daily close</summary><form method="post" action="/ydental/settlement/action">
                        <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                        <input type="hidden" name="operation" value="close"/>
                        <label>门店业务日 <input type="date" name="business_date" required="required"/></label>
                        <label>方式 <select name="channel"><option value="cash">现金</option><option value="wechat">微信线下</option>
                            <option value="alipay">支付宝线下</option><option value="card">银行卡线下</option></select></label>
                        <button type="submit">确认日结并锁定</button>
                    </form>
                    <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details><div t-foreach="closes" t-as="close">
                        <p>日结 <span t-out="close.ydental_business_date"/> · <span t-out="close.ydental_cashier_id.name"/> /
                            <span t-out="channel_labels[close.ydental_channel]"/> / <span t-out="close_labels[close.ydental_state]"/>:
                            Actual collections <span t-out="money(close.ydental_gross, close.ydental_currency_id)"/>、实退 <span t-out="money(close.ydental_refunded, close.ydental_currency_id)"/>, non-terminal refund exposure (snapshot at confirmation, includes unapproved requests) <span t-out="money(close.ydental_pending, close.ydental_currency_id)"/></p>
                        <details name="settlement-operation" class="o_ydental_access_operation" t-if="can_approve and close.ydental_state == 'confirmed'"><summary>Unlock daily close with evidence</summary><form method="post" action="/ydental/settlement/action">
                            <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                            <input type="hidden" name="operation" value="unlock"/>
                            <input type="hidden" name="close_id" t-att-value="close.id"/>
                            <label>财务解锁原因 <input type="text" name="reason" maxlength="300" required="required"/></label>
                            <button type="submit">财务解锁</button>
                        </form>
                    <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details><details><summary>Source trace</summary>Daily close reference <t t-out="close.id"/>; cycle <t t-out="close.ydental_cycle"/>; confirmed UTC <t t-out="close.ydental_confirmed_at"/></details></div>
                    <t t-set="page_kind" t-value="'closes'"/><t t-call="ydental_settlement.ydental_settlement_page_links"/>
                </section>
                <section t-if="can_trade"><h2>跨法人真实销售与采购</h2>
                    <p>仅在双方门店均有仓库及财务审批权、已配置原生科目与两批次时确认。</p>
                    <details name="settlement-operation" class="o_ydental_access_operation"><summary>Process intercompany stock transaction</summary><form method="post" action="/ydental/settlement/action">
                        <t t-call="ydental_settlement.ydental_settlement_tokens"/>
                        <input type="hidden" name="operation" value="trade"/>
                        <label>目标门店 ID <input type="number" name="target_store_id" min="1" required="required"/></label>
                        <label>源批次 ID <input type="number" name="source_lot_id" min="1" required="required"/></label>
                        <label>目标批次 ID <input type="number" name="target_lot_id" min="1" required="required"/></label>
                        <label>数量 <input type="number" name="quantity" min="0.001" step="0.001" required="required"/></label>
                        <label>单位 ID <input type="number" name="uom_id" min="1" required="required"/></label>
                        <label>双方同币种演示单价 <input type="number" name="unit_price" min="0.01" step="0.01" required="required"/></label>
                        <label>不可重复来源 <input type="text" name="source_key" maxlength="120" required="required"/></label>
                        <label>双方审批与实物交易原因 <input type="text" name="reason" maxlength="300" required="required"/></label>
                        <button type="submit">确认双法人原生订单、收发与凭证</button>
                    </form>
                <a t-att-href="'/ydental/settlement?patient_id=%s' % patient.id if patient else '/ydental/settlement'">Cancel and return to viewing</a></details></section>
            </main>
        </t>
    </template>
</odoo>
